#!/usr/bin/env bash
#
# commit-msg — soft warnings for commit subjects (ADVISORY ONLY)
# -----------------------------------------------------------------
# Prints warnings for:
#   1. Subject line longer than 72 chars
#   2. Missing Conventional-Commits prefix (feat|fix|docs|chore|...):
#   3. Subject starts with "WIP" or ends with a period
#   4. Body has 8+ bullet points AND no section headers — the classic
#      "mega-commit" shape that's hard to review or revert cleanly
#
# This hook NEVER blocks a commit. Exit is always 0. If a developer
# needs to intentionally break the rules, the warning is enough.
#
# Set SERVAL_COMMIT_LINT=off to silence.
# -----------------------------------------------------------------

set -u  # nounset only; no -e so we never accidentally fail the commit

if [ "${SERVAL_COMMIT_LINT:-}" = "off" ]; then
  exit 0
fi

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  # Nothing to lint; don't fail the commit.
  exit 0
fi

# Strip comment lines that git adds to the editor (#-prefixed).
MSG_CONTENT="$(grep -v '^#' "$MSG_FILE" 2>/dev/null || true)"

# First non-empty line = subject.
SUBJECT="$(printf '%s\n' "$MSG_CONTENT" | awk 'NF{print; exit}')"

# Skip linting for merge / revert / fixup / squash commits — these have
# machine-generated subjects that we don't want to flag.
case "$SUBJECT" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*)
    exit 0
    ;;
esac

# Skip if empty (git will reject anyway).
if [ -z "$SUBJECT" ]; then
  exit 0
fi

WARNINGS=()

# ---------------------------------------------------------------
# Check 1 — subject length
# ---------------------------------------------------------------
SUBJECT_LEN=${#SUBJECT}
if [ "$SUBJECT_LEN" -gt 72 ]; then
  WARNINGS+=("Subject is ${SUBJECT_LEN} chars (soft limit: 72). Consider moving detail to the body.")
fi

# ---------------------------------------------------------------
# Check 2 — Conventional Commits prefix
# Accepted types: feat, fix, docs, chore, refactor, test, perf, ci,
#                 build, style, revert, deps
# Optional !  for breaking changes. Optional (scope).
# ---------------------------------------------------------------
CC_RE='^(feat|fix|docs|chore|refactor|test|perf|ci|build|style|revert|deps)(\([^)]+\))?!?: .+'
if ! printf '%s' "$SUBJECT" | grep -Eq "$CC_RE"; then
  WARNINGS+=("Subject is not Conventional-Commits-shaped. Expected: <type>(optional-scope): <summary>")
fi

# ---------------------------------------------------------------
# Check 3 — WIP / trailing period / lowercase-after-colon sanity
# ---------------------------------------------------------------
case "$SUBJECT" in
  WIP*|wip*|"Wip"*)
    WARNINGS+=("Subject starts with 'WIP' — consider squashing before landing.")
    ;;
esac

# Trailing period after subject — common drift from markdown-style prose.
case "$SUBJECT" in
  *.)
    # Only warn if it's not an ellipsis
    case "$SUBJECT" in
      *...) : ;;
      *) WARNINGS+=("Subject ends with '.' — convention is no trailing period.") ;;
    esac
    ;;
esac

# ---------------------------------------------------------------
# Check 4 — mega-commit heuristic
#   Many bullets + no section headers = long scrollable wall-of-changes
# ---------------------------------------------------------------
BULLET_COUNT=$(printf '%s\n' "$MSG_CONTENT" | grep -cE '^[[:space:]]*[-*][[:space:]]' || true)
HEADER_COUNT=$(printf '%s\n' "$MSG_CONTENT" | grep -cE '^#{1,6}[[:space:]]|^[A-Z][A-Za-z ]+:$' || true)

if [ "${BULLET_COUNT:-0}" -ge 8 ] && [ "${HEADER_COUNT:-0}" -eq 0 ]; then
  WARNINGS+=("Commit body has ${BULLET_COUNT} bullets and no section headers — consider splitting into smaller commits or adding ## section headers for reviewability.")
fi

# ---------------------------------------------------------------
# Emit warnings (if any). NEVER fail the commit.
# ---------------------------------------------------------------
if [ "${#WARNINGS[@]}" -gt 0 ]; then
  printf '\n'
  printf '⚠  commit-msg soft-warnings (advisory, not blocking):\n' >&2
  for W in "${WARNINGS[@]}"; do
    printf '   - %s\n' "$W" >&2
  done
  printf '\n   Tip: set SERVAL_COMMIT_LINT=off to silence, or amend with `git commit --amend`.\n\n' >&2
fi

exit 0
