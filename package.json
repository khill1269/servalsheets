{
  "name": "servalsheets",
  "mcpName": "io.github.khill1269/servalsheets",
  "version": "2.0.0",
  "description": "Production-grade MCP server for Google Sheets — 25 tools, 409 actions",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./utils/webhook-verification": {
      "import": "./dist/utils/webhook-verification.js",
      "types": "./dist/utils/webhook-verification.d.ts"
    },
    "./security/webhook-signature": {
      "import": "./dist/security/webhook-signature.js",
      "types": "./dist/security/webhook-signature.d.ts"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build -w packages/serval-core -w packages/mcp-client -w packages/mcp-http -w packages/mcp-runtime -w packages/mcp-stdio",
    "build": "tsc -p tsconfig.build.json && npm run generate:metadata",
    "postbuild": "node scripts/copy-runtime-assets.mjs",
    "build:cli": "tsc && node dist/cli.js",
    "start": "node dist/server.js",
    "start:http": "node dist/http-server.js",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:fast": "vitest --run tests/unit tests/contracts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "verify": "npm run typecheck && npm run lint && npm run test:run && npm run check:drift",
    "verify:release": "bash scripts/verify-release-readiness.sh",
    "verify:safe": "npm run typecheck && npm run test:run && npm run check:drift",
    "verify:build": "npm run build && npm run verify",
    "release:audit": "bash scripts/release-audit.sh",
    "schema:commit": "node scripts/generate-metadata.ts && npm run test:run -- tests/contracts && git add src/generated/ src/schemas/action-counts.ts src/mcp/completions.ts server.json 2>/dev/null || true",
    "check:drift": "bash scripts/check-metadata-drift.sh",
    "check:source-dist": "node --import tsx scripts/check-source-dist-consistency.ts --allow-missing-dist",
    "check:placeholders": "bash scripts/no-placeholders.sh",
    "check:doc-action-counts": "bash scripts/check-doc-action-counts.sh",
    "check:debug-prints": "bash scripts/check-debug-prints.sh",
    "check:silent-fallbacks": "bash scripts/check-silent-fallbacks.sh",
    "check:integration-wiring": "node scripts/check-integration-wiring.mjs",
    "check:mutation-actions": "node scripts/check-mutation-actions.mjs",
    "check:file-sizes": "bash scripts/check-file-sizes.sh",
    "validate:alignment": "node --import tsx scripts/validate-schema-handler-alignment.ts",
    "validate:mcp-protocol": "bash scripts/validate-mcp-protocol.sh",
    "validate:dead-code": "bash scripts/verify-dead-code-claims.sh",
    "gates": "npm run typecheck && npm run test:run && npm run check:drift",
    "audit:quick": "node scripts/run-quick-audit.js",
    "audit:coverage": "vitest --run tests/audit/action-coverage.test.ts",
    "audit:perf": "vitest --run tests/audit/performance-profile.bench.ts",
    "audit:memory": "vitest --run tests/audit/memory-leaks.test.ts",
    "audit:snapshot": "node scripts/generate-health-snapshot.ts",
    "audit:gate": "bash scripts/audit-gate.sh",
    "audit:full": "npm run audit:coverage && npm run audit:perf && npm run audit:memory && npm run audit:gate && npm run audit:snapshot",
    "generate:metadata": "tsx scripts/generate-metadata.ts",
    "generate:state": "node .serval/generate-state.mjs",
    "validate:actions": "node scripts/validate-actions.mjs",
    "validate:compliance": "node --import tsx scripts/validate-api-mcp-compliance.ts",
    "validate:server-json": "node scripts/validate-server-json.mjs",
    "validate:server-json-extended": "node --import tsx scripts/validate-server-json-extended.ts",
    "check:metadata-strict": "node --import tsx scripts/check-metadata-strict.ts",
    "check:zod-markers": "node scripts/check-zod-markers.mjs",
    "check:architecture": "bash scripts/check-architecture.sh",
    "check:jwt-scope": "bash scripts/check-jwt-scope.sh",
    "check:secrets": "bash scripts/check-secrets.sh",
    "check:security-exceptions": "node scripts/check-security-exceptions.mjs",
    "security:tool-hashes": "node --import tsx scripts/generate-tool-hashes.ts",
    "security:tool-hashes:check": "node --import tsx scripts/generate-tool-hashes.ts --check",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "smoke": "bash scripts/smoke-test.sh",
    "test:compliance": "vitest --run tests/compliance",
    "test:admin": "vitest --run tests/admin",
    "test:services": "vitest --run tests/services",
    "test:live:fast": "vitest --run tests/live-api",
    "test:live:smoke": "vitest --run --config tests/config/vitest.config.live.smoke.ts",
    "test:live:nightly": "vitest --run --config tests/config/vitest.config.live.nightly.ts",
    "test:live:full": "vitest --run --config tests/config/vitest.config.live.nightly.ts",
    "test:live:optimizations": "vitest --run --config tests/config/vitest.config.live.optimizations.ts",
    "test:snapshots": "vitest --run tests/snapshots",
    "test:integration": "vitest --run tests/integration",
    "test:mcp-http-task-contract": "vitest --run tests/packages/mcp-http",
    "test:http-transport-failover": "vitest --run tests/http-server/http-transport-failover.test.ts",
    "test:coverage:tracking": "vitest --run --coverage",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "pretest": "npm run typecheck"
  },
  "keywords": [
    "mcp",
    "google-sheets",
    "api",
    "spreadsheet",
    "automation"
  ],
  "author": "ServalSheets Contributors",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^5.4.0",
    "@duckdb/node-api": "^1.5.0-r.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-prometheus": "^0.214.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@serval/core": "workspace:*",
    "@serval/mcp-client": "workspace:*",
    "@serval/mcp-http": "workspace:*",
    "@serval/mcp-runtime": "workspace:*",
    "@serval/mcp-stdio": "workspace:*",
    "@types/node-cron": "^3.0.11",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "deep-diff": "^1.0.2",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "google-auth-library": "^10.5.0",
    "googleapis": "^171.4.0",
    "graphql": "^16.12.0",
    "helmet": "^8.1.0",
    "hyperformula": "^3.2.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.3.5",
    "node-cron": "^4.2.1",
    "open": "^11.0.0",
    "p-queue": "^9.1.2",
    "prom-client": "^15.1.3",
    "stripe": "^17.5.0",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@emnapi/wasi-threads": "^1.2.1",
    "@flydotio/dockerfile": "^0.7.10",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/jest-runner": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/deep-diff": "^1.0.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/stripe": "^8.0.416",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.2",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "autocannon": "^8.0.0",
    "bindings": "^1.5.0",
    "chokidar": "^5.0.0",
    "cspell": "^9.6.4",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.39.2",
    "eslint-plugin-boundaries": "^5.4.0",
    "fast-check": "^4.5.3",
    "husky": "^9.1.7",
    "knip": "^6.1.1",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.22.0",
    "npm-run-all": "^4.1.5",
    "openapi-types": "^12.1.3",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "search-insights": "^2.17.3",
    "supertest": "^7.2.2",
    "syncpack": "^14.3.0",
    "ts-prune": "^0.10.3",
    "tsx": "^4.21.0",
    "turbo": "^2.9.3",
    "typedoc": "^0.28.16",
    "vite": "^7.3.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.2",
    "yaml": "^2.8.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.28.0",
    "@oxc-parser/binding-darwin-arm64": "^0.127.0",
    "@oxc-resolver/binding-darwin-arm64": "^11.19.1",
    "@rollup/rollup-darwin-arm64": "^4.60.2",
    "ioredis": "^5.10.0",
    "keytar": "7.9.0",
    "pyodide": "^0.29.3",
    "redis": "5.11.0"
  },
  "overrides": {
    "xmldom": "npm:@xmldom/xmldom@^0.9.0",
    "handlebars": "^4.7.9",
    "diff": ">=8.0.3",
    "protobufjs": "^7.5.5",
    "esbuild": ">=0.24.3",
    "smol-toml": ">=1.6.1"
  },
  "workspaces": [
    "packages/serval-core",
    "packages/mcp-client",
    "packages/mcp-http",
    "packages/mcp-runtime",
    "packages/mcp-stdio"
  ]
}
