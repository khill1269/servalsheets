{
  "name": "servalsheets",
  "mcpName": "ServalSheets",
  "version": "2.0.0",
  "description": "Production-grade MCP server for Google Sheets with 25 tools and 409 actions",
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./utils/webhook-verification": {
      "import": "./dist/utils/webhook-verification.js",
      "types": "./dist/utils/webhook-verification.d.ts"
    },
    "./security/webhook-signature": {
      "import": "./dist/security/webhook-signature.js",
      "types": "./dist/security/webhook-signature.d.ts"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build -w packages/serval-core",
    "build": "tsc && npm run generate:metadata",
    "build:docker": "npm run build --workspaces --if-present && tsc",
    "build:cli": "tsc && node dist/cli.js",
    "start": "node dist/server.js",
    "start:http": "node dist/http-server.js",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:fast": "vitest --run tests/unit tests/contracts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "verify": "npm run typecheck && npm run lint && npm run test:run && npm run check:drift",
    "verify:safe": "npm run typecheck && npm run test:run && npm run check:drift",
    "verify:build": "npm run build && npm run verify",
    "verify:release": "npm run typecheck && npm run test:fast && npm run build && npm audit --audit-level=high && npm run check:drift",
    "schema:commit": "node scripts/generate-metadata.ts && npm run test:run -- tests/contracts && git add src/generated/ src/schemas/action-counts.ts src/mcp/completions.ts server.json 2>/dev/null || true",
    "schema:fetch": "node scripts/schema-fetch.mjs",
    "schema:compare": "node scripts/schema-compare.mjs",
    "schema:migration-report": "node scripts/schema-migration-report.mjs",
    "check:drift": "bash scripts/check-metadata-drift.sh",
    "check:placeholders": "bash scripts/no-placeholders.sh",
    "check:debug-prints": "bash scripts/check-debug-prints.sh",
    "check:silent-fallbacks": "bash scripts/check-silent-fallbacks.sh",
    "check:integration-wiring": "node scripts/check-integration-wiring.mjs",
    "check:mutation-actions": "node scripts/check-mutation-actions.mjs",
    "validate:alignment": "node --import tsx scripts/validate-schema-handler-alignment.ts",
    "validate:dead-code": "bash scripts/verify-dead-code-claims.sh",
    "validate:action-config": "node --import tsx scripts/validate-action-configuration.ts",
    "validate:compliance": "node --import tsx scripts/validate-api-mcp-compliance.ts",
    "gates": "npm run typecheck && npm run test:run && npm run check:drift",
    "audit:coverage": "vitest --run tests/audit/action-coverage.test.ts",
    "audit:perf": "vitest --run tests/audit/performance-profile.bench.ts",
    "audit:memory": "vitest --run tests/audit/memory-leaks.test.ts",
    "audit:snapshot": "node scripts/generate-health-snapshot.ts",
    "audit:gate": "bash scripts/audit-gate.sh",
    "audit:quick": "npm audit --audit-level=high",
    "audit:full": "npm run audit:coverage && npm run audit:perf && npm run audit:memory && npm run audit:gate && npm run audit:snapshot",
    "generate:metadata": "node scripts/generate-metadata.ts",
    "generate:state": "node .serval/generate-state.mjs",
    "validate:actions": "node scripts/validate-actions.mjs",
    "validate:server-json": "node scripts/validate-server-json.mjs",
    "validate:server-json-extended": "node --import tsx scripts/validate-server-json-extended.ts",
    "check:metadata-strict": "node --import tsx scripts/check-metadata-strict.ts",
    "check:zod-markers": "node scripts/check-zod-markers.mjs",
    "check:architecture": "bash scripts/check-architecture.sh",
    "check:test-determinism": "bash scripts/check-test-determinism.sh",
    "check:handler-types": "bash scripts/check-handler-type-safety.sh",
    "check:schema-passthrough": "bash scripts/check-schema-passthrough.sh",
    "check:sheets-fields": "bash scripts/check-sheets-fields-param.sh",
    "check:tautologies": "bash scripts/check-tautological-assertions.sh",
    "check:dead-code:baseline": "node scripts/dead-code-triage.mjs --no-write",
    "check:jwt-scope": "bash scripts/check-jwt-scope.sh",
    "check:secrets": "bash scripts/check-secrets.sh",
    "check:security-exceptions": "node scripts/check-security-exceptions.mjs",
    "docs:freshness": "node --import tsx scripts/check-doc-freshness.ts",
    "docs:freshness:ci": "npm run docs:freshness",
    "docs:lint:baseline": "node scripts/check-markdownlint-baseline.mjs",
    "docs:check-links": "bash scripts/check-doc-links.sh",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "smoke": "bash scripts/smoke-test.sh",
    "test:snapshots": "vitest --run tests/snapshots",
    "test:integration": "vitest --run tests/integration",
    "test:mcp-http-task-contract": "vitest --run tests/packages/mcp-http",
    "test:http-transport-failover": "vitest --run tests/http-server/http-transport-failover.test.ts",
    "test:coverage:tracking": "vitest --run --coverage",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "pretest": "npm run typecheck"
  },
  "keywords": [
    "mcp",
    "google-sheets",
    "api",
    "spreadsheet",
    "automation"
  ],
  "author": "ServalSheets Contributors",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@apollo/server": "^5.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.214.0",
    "@opentelemetry/exporter-prometheus": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-zipkin": "^2.0.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "axios": "^1.8.1",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "date-fns": "^4.1.0",
    "deep-diff": "^1.0.2",
    "dotenv": "^17.4.2",
    "duckdb": "^1.4.4",
    "eventemitter3": "^5.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "gaxios": "^7.1.4",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "got": "^15.0.2",
    "graphql": "^16.12.0",
    "helmet": "^8.1.0",
    "hyperformula": "^3.2.0",
    "ioredis": "^5.4.1",
    "joi": "^18.1.2",
    "js-base64": "^3.7.6",
    "jsonwebtoken": "^9.0.0",
    "lru-cache": "^10.2.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "open": "^11.0.0",
    "p-queue": "^9.1.2",
    "papaparse": "^5.4.1",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "pyodide": "^0.29.3",
    "redis": "^5.11.0",
    "sharp": "^0.34.5",
    "stripe": "^22.0.0",
    "swagger-ui-express": "^5.0.1",
    "tinypool": "^0.8.4",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "workerpool": "^10.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/deep-diff": "^1.0.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/papaparse": "^5.3.14",
    "@types/pdfkit": "^0.17.5",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "chokidar": "^5.0.0",
    "eslint": "^10.2.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "fast-check": "^4.6.0",
    "prettier": "^3.4.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4",
    "yaml": "^2.8.3"
  },
  "workspaces": [
    "packages/mcp-client",
    "packages/mcp-http",
    "packages/mcp-runtime",
    "packages/mcp-stdio",
    "packages/serval-core"
  ],
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.0.0-rc.15"
  }
}
