# Local observability configuration for ServalSheets dev
# Copy relevant lines into your .env.local, then:
#   1. Start the observability stack: cd deployment/observability && docker compose up -d
#   2. Start ServalSheets with: npm run dev (with these env vars set)
#   3. Open Grafana: http://localhost:3001 (admin/admin)
#   4. Open Prometheus: http://localhost:9090
#   5. View distributed traces in Tempo via Grafana → Explore → Tempo

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=servalsheets-dev
OTEL_TRACE_SAMPLE_RATE=1.0

# Send traces to local Tempo (in observability docker-compose)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Or to console (no collector needed, good for quick debugging):
# OTEL_TRACES_EXPORTER=console

# ── Prometheus metrics server ─────────────────────────────────────────────────
ENABLE_METRICS_SERVER=true
METRICS_PORT=9090
METRICS_HOST=127.0.0.1
# After enabling: curl http://localhost:9090/metrics | grep servalsheets_

# ── Structured logging ────────────────────────────────────────────────────────
LOG_LEVEL=debug
# All logs include: requestId, traceId, spanId, tool, action

# ── Per-tool debug filtering ──────────────────────────────────────────────────
# Uncomment to enable per-tool verbose logging during dev/test:
# DEBUG_TOOL=sheets_data
# DEBUG_ACTION=read
# DEBUG_VERBOSE=true
# Then run: npm run test:fast  or  npm run dev

# ── Start local observability stack ──────────────────────────────────────────
# cd deployment/observability && docker compose up -d
#
# Services started:
#   Prometheus  → http://localhost:9090   (metrics scraping from :9090/metrics)
#   Grafana     → http://localhost:3001   (admin / admin)
#   Loki        → http://localhost:3100   (log aggregation)
#   Tempo       → http://localhost:3200   (distributed traces, OTLP on :4317/:4318)
#   Alertmanager→ http://localhost:9093   (alert routing)
#
# Grafana datasources are pre-configured (prometheus.yml provisioning).
# Connect Grafana to Tempo for trace_id exemplar linking from metrics → traces.
