# ServalSheets Quick Start
# Copy to .env and fill in your values

# Google OAuth credentials (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# Tool presentation mode (default: bundled — 25 compound tools, recommended)
# Valid values: 'bundled' | 'flat'
# - bundled: 25 compound tools with discriminated-union 'action' parameter
# - flat:    ~410 individual tools, one per action (only safe with clients
#            that natively implement tool deferral — most do not)
# Leave unset to use the bundled default. See src/config/constants.ts.
# SERVAL_TOOL_MODE=bundled
# SERVAL_DEFER_SCHEMAS and SERVAL_DEFER_DESCRIPTIONS auto-detect transport

# Server port (only needed for HTTP mode: node dist/cli.js --http)
# PORT=3000

# DNS rebinding protection: additional allowed hostnames (comma-separated)
# Default allows: localhost, 127.0.0.1, ::1, 0.0.0.0
# SERVAL_ALLOWED_HOSTS=myhost.example.com,other.local

# AI sampling / LLM fallback (optional — enables AI-powered features like smart analysis)
# Provider: anthropic (default) | openai | google
# LLM_PROVIDER=anthropic
# API key for the chosen provider (only one is required):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# Model to use (defaults: claude-sonnet-4-6 | gpt-4o | gemini-2.0-flash)
# LLM_MODEL=claude-sonnet-4-6
# Custom base URL (optional, for proxies or local LLM endpoints)
# LLM_BASE_URL=https://api.anthropic.com
# Set to false to disable sampling entirely even if an API key is present
# ENABLE_SAMPLING=true
