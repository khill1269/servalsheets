{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/cli.ts",
    "src/server.ts",
    "src/http-server.ts",
    "src/remote-server.ts",
    "tests/**/*.test.ts",
    "tests/**/*.spec.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.cjs"
  ],
  "project": [
    "src/**/*.ts",
    "!src/**/*.d.ts"
  ],
  "ignore": [
    "src/**/*.d.ts",
    "docs/**",
    "scripts/archive/**",
    "dist/**",
    "coverage/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "vite.config.ts"
  ],
  "ignoreDependencies": [
    "@types/*",
    "@apollo/server",
    "@modelcontextprotocol/sdk",
    "@node-saml/node-saml",
    "@opentelemetry/*",
    "@serval/core",
    "better-sqlite3",
    "chalk",
    "cli-table3",
    "commander",
    "compression",
    "cors",
    "deep-diff",
    "dotenv",
    "duckdb",
    "express-rate-limit",
    "gaxios",
    "google-auth-library",
    "googleapis",
    "graphql",
    "helmet",
    "hyperformula",
    "ioredis",
    "jsonwebtoken",
    "lru-cache",
    "node-cron",
    "open",
    "p-queue",
    "prom-client",
    "pyodide",
    "redis",
    "stripe",
    "swagger-ui-express",
    "uuid",
    "winston"
  ],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false,
  "vite": {
    "config": []
  },
  "vitest": {
    "config": ["vitest.config.ts", "vitest.config.*.ts"],
    "entry": ["tests/**/*.test.ts", "tests/**/*.spec.ts"]
  },
  "eslint": {
    "config": ["eslint.config.js"],
    "entry": ["**/*.ts"]
  },
  "typescript": {
    "config": ["tsconfig.json", "tsconfig.*.json"],
    "entry": ["src/**/*.ts"]
  }
}
