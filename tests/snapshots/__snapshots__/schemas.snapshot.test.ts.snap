                      "low",
                      "medium",
                      "high"
                    ],
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "tool": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "optimization",
                      "alternative",
                      "follow_up",
                      "warning",
