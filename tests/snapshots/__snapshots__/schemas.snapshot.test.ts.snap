          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "action": {
      "const": "preview_generation",
      "type": "string"
    },
    "definition": {
      "additionalProperties": false,
      "description": "Proposed sheet structure (not yet created)",
      "properties": {
        "sheets": {
          "description": "Sheet definitions",
          "items": {
            "additionalProperties": false,
            "properties": {
              "columns": {
                "description": "Column definitions",
