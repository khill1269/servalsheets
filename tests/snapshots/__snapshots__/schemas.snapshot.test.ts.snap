            "scenarios"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "create_scenario_sheet",
              "description": "Materialize a scenario as a new sheet tab (non-destructive copy with changes applied)",
              "type": "string"
            },
