      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "validate",
              "description": "Validate data using built-in validators and custom single-value rules",
              "type": "string"
            },
            "context": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "items": {},
                    "type": "array"
                  },
                  {
                    "additionalProperties": {},
                    "propertyNames": {
                      "type": "string"
                    },
                    "type": "object"
                  }
                ]
              },
              "description": "Validation context: spreadsheetId, sheetName, range, etc.",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "rules": {
              "description": "Rules to apply. Built-ins: builtin_string, builtin_number, builtin_boolean, builtin_date, builtin_positive, builtin_non_negative, builtin_email, builtin_url, builtin_phone, builtin_required, builtin_non_empty_string. Custom object rules support comparison, pattern, length, and one_of checks. Example: [\\"builtin_required\\", { \\"type\\": \\"comparison\\", \\"operator\\": \\"gt\\", \\"compareTo\\": { \\"contextKey\\": \\"cogs\\" }, \\"message\\": \\"Unit Price must exceed COGS\\" }]",
              "items": {
                "anyOf": [
                  {
                    "description": "Built-in validation rule ID: builtin_string (value is a string), builtin_number (valid number), builtin_boolean (true/false/0/1/yes/no), builtin_date (ISO 8601 date), builtin_positive (number > 0), builtin_non_negative (number >= 0), builtin_email (valid email format), builtin_url (valid HTTP/HTTPS URL), builtin_phone (phone number format), builtin_required (non-empty value), builtin_non_empty_string (string with non-whitespace content)",
                    "enum": [
                      "builtin_string",
                      "builtin_number",
                      "builtin_boolean",
                      "builtin_date",
                      "builtin_positive",
                      "builtin_non_negative",
                      "builtin_email",
                      "builtin_url",
                      "builtin_phone",
                      "builtin_required",
                      "builtin_non_empty_string"
                    ],
                    "type": "string"
                  },
                  {
                    "oneOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "compareTo": {
                            "anyOf": [
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "value": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "number"
                                      },
                                      {
                                        "type": "boolean"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ],
                                    "description": "Literal value to compare against"
                                  }
                                },
                                "required": [
                                  "value"
                                ],
                                "type": "object"
                              },
