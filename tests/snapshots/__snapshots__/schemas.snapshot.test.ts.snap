                  },
                  "type": "array"
                },
                "retryable": {
                  "default": false,
                  "type": "boolean"
                },
                "retryAfterMs": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "retryStrategy": {
                  "description": "Recommended retry strategy",
                  "enum": [
                    "exponential_backoff",
                    "wait_for_reset",
