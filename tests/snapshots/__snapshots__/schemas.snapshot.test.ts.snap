                  "additionalProperties": false,
                  "description": "Structured fix suggestion with tool/action to resolve the error",
                  "properties": {
                    "action": {
                      "description": "Action name to fix the issue",
                      "type": "string"
                    },
                    "explanation": {
                      "description": "Same string as \`suggestedFix\`; duplicated here for callers that only read fixableVia",
                      "type": "string"
                    },
                    "params": {
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
