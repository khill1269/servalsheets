                    "EFFECT_SCOPE_EXCEEDED",
                    "EXPLICIT_RANGE_REQUIRED",
                    "AMBIGUOUS_RANGE",
                    "FEATURE_UNAVAILABLE",
                    "FEATURE_DEGRADED",
                    "AUTHENTICATION_REQUIRED",
                    "AUTH_ERROR",
                    "CONFIG_ERROR",
                    "NOT_CONFIGURED",
                    "VALIDATION_ERROR",
                    "NOT_FOUND",
                    "NOT_IMPLEMENTED",
