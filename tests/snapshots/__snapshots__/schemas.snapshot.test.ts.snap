                  "type": "boolean"
                },
                "dryRun": {
                  "default": false,
                  "type": "boolean"
                },
                "effectScope": {
                  "additionalProperties": false,
                  "properties": {
                    "maxCellsAffected": {
                      "default": 50000,
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "type": "integer"
                    },
                    "maxColumnsAffected": {
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "type": "integer"
                    },
                    "maxRowsAffected": {
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
