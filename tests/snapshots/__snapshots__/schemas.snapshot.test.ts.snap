          "description": "Related tools that might be useful",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retrievalUri": {
          "description": "Resource URI for retrieving full non-truncated payload",
          "type": "string"
        },
        "snapshot": {
          "additionalProperties": false,
          "description": "Snapshot info for undo/rollback",
          "properties": {
            "description": {
              "description": "Human-readable snapshot description",
              "type": "string"
            },
            "metadata": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": "Additional snapshot metadata",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "snapshotId": {
              "description": "Unique snapshot identifier",
              "type": "string"
            },
            "timestamp": {
              "description": "ISO 8601 timestamp of snapshot creation",
              "type": "string"
            }
          },
          "required": [
            "snapshotId",
            "timestamp"
          ],
          "type": "object"
        },
        "suggestions": {
          "description": "Follow-up tool suggestions and optimizations",
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "priority": {
                "default": "medium",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "optimization",
                  "alternative",
                  "follow_up",
                  "warning",
                  "related"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "message",
              "reason",
              "priority"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "summary": {
          "additionalProperties": false,
          "description": "Summary statistics for list-type responses",
          "properties": {
            "byStatus": {
              "additionalProperties": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              "description": "Counts grouped by status",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "total": {
              "description": "Total item count",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "total"
          ],
          "type": "object"
        },
        "truncated": {
          "description": "True when response payload was truncated and full data is available elsewhere",
          "type": "boolean"
        },
        "verificationSummary": {
          "description": "Short verification summary describing what was checked or confirmed",
          "type": "string"
        },
        "warnings": {
          "description": "Safety warnings or considerations",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "action": {
      "const": "generate_sheet",
      "type": "string"
    },
    "columnsCreated": {
      "description": "Total columns across all sheets",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "definition": {
      "additionalProperties": false,
      "description": "Full sheet definition (included at detailed verbosity)",
      "properties": {
        "sheets": {
          "description": "Sheet definitions",
          "items": {
            "additionalProperties": false,
            "properties": {
              "columns": {
                "description": "Column definitions",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "description": {
                      "description": "Column description (used for data validation tooltip)",
                      "type": "string"
                    },
                    "formula": {
                      "description": "Row-level formula template (use {row} for current row)",
                      "type": "string"
                    },
                    "header": {
                      "description": "Column header text",
                      "type": "string"
                    },
                    "numberFormat": {
                      "description": "Custom number format pattern",
                      "type": "string"
                    },
                    "type": {
                      "description": "Data type for formatting and validation",
                      "enum": [
                        "text",
                        "number",
                        "currency",
                        "percentage",
                        "date",
                        "boolean",
                        "formula"
                      ],
                      "type": "string"
                    },
                    "width": {
                      "description": "Column width in pixels",
                      "maximum": 500,
                      "minimum": 30,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "header",
                    "type"
                  ],
                  "type": "object"
                },
                "maxItems": 50,
                "minItems": 1,
                "type": "array"
              },
              "formatting": {
                "additionalProperties": false,
                "description": "Formatting specification",
                "properties": {
                  "alternatingRows": {
                    "default": false,
                    "description": "Enable alternating row colors",
                    "type": "boolean"
                  },
                  "conditionalRules": {
                    "description": "Conditional formatting rules",
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "range": {
                          "description": "A1 notation range to apply the rule",
                          "type": "string"
                        },
                        "rule": {
                          "description": "Preset conditional formatting rule",
                          "enum": [
                            "negative_red",
                            "positive_green",
                            "zero_gray",
                            "above_average_green",
                            "below_average_red",
                            "color_scale",
                            "data_bar"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "range",
                        "rule"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "freezeColumns": {
                    "default": 0,
                    "description": "Columns to freeze",
                    "maximum": 5,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "freezeRows": {
                    "default": 1,
                    "description": "Rows to freeze",
                    "maximum": 10,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "headerStyle": {
                    "default": "bold_blue_background",
                    "description": "Header row style preset",
                    "enum": [
                      "bold_blue_background",
                      "bold_gray_background",
                      "bold_underline",
                      "bold_border_bottom"
                    ],
                    "type": "string"
                  },
                  "numberFormat": {
                    "description": "Default number format for currency/number columns",
                    "type": "string"
                  }
                },
                "required": [
                  "headerStyle",
                  "freezeRows",
                  "freezeColumns",
                  "alternatingRows"
                ],
                "type": "object"
              },
              "name": {
                "description": "Sheet/tab name",
                "maxLength": 255,
                "type": "string"
              },
              "rows": {
                "description": "Sample data rows",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "formulas": {
                      "description": "Override formulas for specific cells (null = use value)",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "type": "array"
                    },
                    "values": {
                      "description": "Cell values in column order",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "values"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "name",
              "columns"
            ],
            "type": "object"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "description": "Spreadsheet title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "sheets"
      ],
      "type": "object"
    },
    "formattingApplied": {
      "description": "Whether formatting was applied",
      "type": "boolean"
    },
    "formulasApplied": {
      "description": "Number of formula cells created",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "rowsCreated": {
      "description": "Total data rows (excluding headers)",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "sheetsCreated": {
      "description": "Number of sheets/tabs created",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "spreadsheetId": {
      "description": "Spreadsheet ID from URL (e.g., \\"1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms\\" from https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit)",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9-_]+$",
      "type": "string"
    },
    "spreadsheetUrl": {
      "description": "URL to open the generated spreadsheet",
      "format": "uri",
      "type": "string"
    },
    "success": {
      "const": true,
      "type": "boolean"
    },
    "title": {
      "description": "Spreadsheet title",
      "type": "string"
    }
  },
  "required": [
    "success",
    "action",
    "spreadsheetId",
    "spreadsheetUrl",
    "title",
    "sheetsCreated",
    "columnsCreated",
    "rowsCreated",
    "formulasApplied",
    "formattingApplied"
  ],
  "type": "object"
}"
`;

