            "CANCELLED",
            "OPERATION_CANCELLED",
            "OPERATION_FAILED",
            "DATA_LOSS",
            "UNAVAILABLE",
            "CONNECTION_ERROR",
            "UNIMPLEMENTED",
            "UNKNOWN",
            "OUT_OF_RANGE",
            "FAILED_PRECONDITION",
            "PRECONDITION_FAILED",
            "EFFECT_SCOPE_EXCEEDED",
            "EXPLICIT_RANGE_REQUIRED",
            "AMBIGUOUS_RANGE",
            "FEATURE_UNAVAILABLE",
            "FEATURE_DEGRADED",
            "AUTHENTICATION_REQUIRED",
            "AUTH_ERROR",
            "CONFIG_ERROR",
            "NOT_CONFIGURED",
            "VALIDATION_ERROR",
            "NOT_FOUND",
            "NOT_IMPLEMENTED",
            "HANDLER_LOAD_ERROR",
            "TOO_MANY_SESSIONS",
            "DATA_ERROR",
            "VERSION_MISMATCH",
            "NO_DATA",
            "SERVICE_NOT_INITIALIZED",
            "SERVICE_NOT_ENABLED",
            "SNAPSHOT_CREATION_FAILED",
            "SNAPSHOT_RESTORE_FAILED",
            "TRANSACTION_CONFLICT",
            "TRANSACTION_EXPIRED",
