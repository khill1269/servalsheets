                }
              },
              "required": [
                "willExceedIn",
                "confidence"
              ],
              "type": "object"
            },
            "recommendation": {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "savings": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "reason",
                "savings"
              ],
              "type": "object"
            },
            "remaining": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "resetIn": {
              "type": "string"
            }
          },
          "required": [
            "current",
            "limit",
            "remaining",
            "resetIn",
            "burnRate"
          ],
          "type": "object"
        },
        "relatedTools": {
          "description": "Related tools that might be useful",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retrievalUri": {
          "description": "Resource URI for retrieving full non-truncated payload",
          "type": "string"
        },
        "snapshot": {
          "additionalProperties": false,
          "description": "Snapshot info for undo/rollback",
