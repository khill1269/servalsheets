exports[`Schema Snapshots > Input Schemas > ExportLargeDatasetInputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "export_large_dataset",
      "description": "Export large dataset with streaming (100K+ rows)",
      "type": "string"
    },
    "chunkSize": {
      "default": 1000,
      "description": "Rows per chunk (default: 1000)",
      "maximum": 10000,
      "minimum": 100,
      "type": "integer"
    },
    "format": {
      "default": "json",
      "description": "Output format (default: json)",
      "enum": [
        "json",
        "csv"
      ],
      "type": "string"
    },
    "range": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "A1 notation range, e.g. \\"Sheet1!A1:D10\\"",
          "properties": {
            "a1": {
              "description": "A1 notation range: \\"A1\\" (single cell), \\"A1:C10\\" (range), \\"Sheet1!A1:C10\\" (with sheet name). Full column refs (A:Z) are rejected — always include row numbers.",
              "maxLength": 500,
              "minLength": 1,
              "pattern": "^[^[\\\\]]+$",
              "type": "string"
            }
          },
          "required": [
            "a1"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Named range identifier, e.g. \\"SalesData\\"",
          "properties": {
            "namedRange": {
              "type": "string"
            }
          },
          "required": [
            "namedRange"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Natural language range description",
          "properties": {
            "semantic": {
              "additionalProperties": false,
              "properties": {
                "column": {
                  "type": "string"
                },
                "includeHeader": {
                  "default": false,
                  "type": "boolean"
                },
                "rowEnd": {
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": "integer"
                },
                "rowStart": {
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": "integer"
                },
                "sheet": {
                  "type": "string"
                }
              },
              "required": [
                "sheet",
                "column",
                "includeHeader"
              ],
              "type": "object"
            }
          },
          "required": [
            "semantic"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Grid coordinate range: { sheetId: number, startRowIndex?: number (0-based), endRowIndex?: number (exclusive), startColumnIndex?: number (0-based), endColumnIndex?: number (exclusive) }",
          "properties": {
            "grid": {
              "additionalProperties": false,
              "properties": {
                "endColumnIndex": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "endRowIndex": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "sheetId": {
                  "description": "Numeric sheet/tab ID (e.g., 0 for first sheet, found in URL #gid=123456789). Use sheets_core get to retrieve sheet IDs.",
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "startColumnIndex": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "startRowIndex": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "sheetId"
              ],
              "type": "object"
            }
          },
          "required": [
            "grid"
          ],
          "type": "object"
        }
      ],
      "description": "Range to export (e.g., \\"Sheet1!A:Z\\" or named range)"
    },
    "spreadsheetId": {
      "description": "Spreadsheet ID to export",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9-_]+$",
      "type": "string"
    },
    "verbosity": {
      "default": "standard",
      "description": "Response detail level",
      "enum": [
        "minimal",
        "standard",
        "detailed"
      ],
      "type": "string"
    }
  },
  "required": [
    "action",
    "spreadsheetId",
    "range",
    "chunkSize",
    "format",
    "verbosity"
  ],
  "type": "object"
}"
`;

