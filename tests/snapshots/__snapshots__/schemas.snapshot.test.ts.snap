                      "description": "Row-level formula template (use {row} for current row)",
                      "type": "string"
                    },
                    "header": {
                      "description": "Column header text",
                      "type": "string"
                    },
                    "numberFormat": {
                      "description": "Custom number format pattern",
                      "type": "string"
                    },
                    "type": {
                      "description": "Data type for formatting and validation",
                      "enum": [
                        "text",
                        "number",
                        "currency",
                        "percentage",
                        "date",
                        "boolean",
                        "formula"
                      ],
                      "type": "string"
                    },
                    "width": {
                      "description": "Column width in pixels",
                      "maximum": 500,
                      "minimum": 30,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "header",
                    "type"
                  ],
                  "type": "object"
                },
                "maxItems": 50,
                "minItems": 1,
                "type": "array"
              },
              "formatting": {
                "additionalProperties": false,
                "description": "Formatting specification",
                "properties": {
                  "alternatingRows": {
                    "default": false,
                    "description": "Enable alternating row colors",
                    "type": "boolean"
                  },
                  "conditionalRules": {
                    "description": "Conditional formatting rules",
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "range": {
                          "description": "A1 notation range to apply the rule",
                          "type": "string"
                        },
                        "rule": {
                          "description": "Preset conditional formatting rule",
                          "enum": [
                            "negative_red",
                            "positive_green",
                            "zero_gray",
                            "above_average_green",
                            "below_average_red",
                            "color_scale",
                            "data_bar"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "range",
                        "rule"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "freezeColumns": {
                    "default": 0,
                    "description": "Columns to freeze",
                    "maximum": 5,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "freezeRows": {
                    "default": 1,
                    "description": "Rows to freeze",
                    "maximum": 10,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "headerStyle": {
                    "default": "bold_blue_background",
                    "description": "Header row style preset",
                    "enum": [
                      "bold_blue_background",
                      "bold_gray_background",
                      "bold_underline",
                      "bold_border_bottom"
                    ],
                    "type": "string"
                  },
                  "numberFormat": {
                    "description": "Default number format for currency/number columns",
                    "type": "string"
                  }
                },
                "required": [
                  "headerStyle",
                  "freezeRows",
                  "freezeColumns",
                  "alternatingRows"
                ],
                "type": "object"
              },
              "name": {
                "description": "Sheet/tab name",
                "maxLength": 255,
                "type": "string"
              },
              "rows": {
                "description": "Sample data rows",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "formulas": {
                      "description": "Override formulas for specific cells (null = use value)",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "type": "array"
                    },
                    "values": {
                      "description": "Cell values in column order",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "values"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "name",
              "columns"
            ],
            "type": "object"
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "description": "Spreadsheet title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "sheets"
      ],
      "type": "object"
    },
    "estimatedCells": {
      "description": "Estimated total cells to be created",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "estimatedFormulas": {
      "description": "Estimated formula cells",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "formattingPreview": {
      "description": "Human-readable list of formatting that would be applied",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "success": {
      "const": true,
      "type": "boolean"
    }
  },
  "required": [
    "success",
    "action",
    "definition",
    "estimatedCells",
    "estimatedFormulas",
    "formattingPreview"
  ],
  "type": "object"
}"
`;

exports[`Schema Snapshots > Output Schemas > PublishReportOutputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "additionalProperties": false,
          "description": "Standardized list envelope metadata",
          "properties": {
            "count": {
              "description": "Number of items in the current response page",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "hasMore": {
              "description": "True when more pages are available",
              "type": "boolean"
            },
            "itemsField": {
              "description": "Field name on response containing the current page item array",
              "minLength": 1,
              "type": "string"
            },
            "limit": {
              "description": "Page size used for this response",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "nextCursor": {
              "description": "Cursor/token for the next page",
              "type": "string"
            },
            "offset": {
              "description": "Offset used for this page when offset-based paging applies",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "totalCount": {
              "description": "Total matching item count when known",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "itemsField",
            "count"
          ],
          "type": "object"
        },
        "continuationHint": {
          "description": "Machine-readable hint describing how to continue retrieval",
          "type": "string"
        },
        "costEstimate": {
          "additionalProperties": false,
          "description": "API call cost estimate",
          "properties": {
            "apiCalls": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "cellsAffected": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "estimatedLatencyMs": {
              "minimum": 0,
              "type": "number"
            },
            "quotaImpact": {
              "additionalProperties": false,
              "properties": {
                "current": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "limit": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "remaining": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "current",
                "limit",
                "remaining"
              ],
              "type": "object"
            }
          },
          "required": [
            "apiCalls",
            "estimatedLatencyMs"
          ],
          "type": "object"
        },
        "deliveredSizeBytes": {
          "description": "Serialized size of the delivered truncated payload",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "deprecationWarning": {
          "description": "Present when the client used a legacy invocation pattern. Contains migration guidance.",
          "type": "string"
        },
        "documentation": {
          "description": "URL to relevant documentation",
          "pattern": "^(?:https?|redis|rediss):\\\\/\\\\/(?:(?:www\\\\.)?[-a-zA-Z0-9@:%._+~#=]{1,256}\\\\.[a-zA-Z0-9()]{1,6}|localhost|(?:\\\\d{1,3}\\\\.){3}\\\\d{1,3})(?::\\\\d{1,5})?(?:[-a-zA-Z0-9()@:%_+.~#?&/=]*)$",
          "type": "string"
        },
        "errorCode": {
          "description": "Original error code reported by the handler when success=false",
          "enum": [
            "PARSE_ERROR",
            "INVALID_REQUEST",
            "METHOD_NOT_FOUND",
            "INVALID_PARAMS",
            "INTERNAL_ERROR",
            "UNAUTHENTICATED",
            "NOT_AUTHENTICATED",
            "PERMISSION_DENIED",
            "INVALID_CREDENTIALS",
            "TOKEN_EXPIRED",
