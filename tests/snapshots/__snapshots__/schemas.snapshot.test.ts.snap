                      "type": "string"
                    }
                  },
                  "required": [
                    "tool",
                    "action"
                  ],
                  "type": "object"
                },
                "message": {
                  "type": "string"
                },
                "resolution": {
                  "description": "Recommended resolution strategy",
                  "type": "string"
                },
                "resolutionSteps": {
                  "description": "Step-by-step instructions to resolve the error",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "resources": {
                  "description": "Resource URIs for error guidance (e.g., servalsheets://decisions/find-sheet, servalsheets://reference/authentication)",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "description": {
                        "type": "string"
                      },
                      "uri": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "uri",
                      "description"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "retryable": {
                  "default": false,
                  "type": "boolean"
                },
                "retryAfterMs": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                },
                "retryStrategy": {
                  "description": "Recommended retry strategy",
                  "enum": [
                    "exponential_backoff",
                    "wait_for_reset",
                    "manual",
                    "reauthorize",
                    "none"
                  ],
                  "type": "string"
                },
                "severity": {
                  "description": "Error severity level",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "critical"
                  ],
                  "type": "string"
                },
                "suggestedFix": {
                  "description": "Human-readable fix hint. For the structured, LLM-executable shape use \`fixableVia\`.",
                  "type": "string"
                },
                "suggestedTools": {
                  "description": "Tools that might help resolve this error",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "type": "object"
            },
            "success": {
              "const": false,
              "type": "boolean"
            }
          },
          "required": [
            "success",
            "error"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "response"
  ],
  "type": "object"
}"
`;

