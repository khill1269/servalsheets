                    "PARSE_ERROR",
                    "INVALID_REQUEST",
                    "METHOD_NOT_FOUND",
                    "INVALID_PARAMS",
                    "INTERNAL_ERROR",
                    "UNAUTHENTICATED",
                    "NOT_AUTHENTICATED",
                    "PERMISSION_DENIED",
