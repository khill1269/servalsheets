                      "type": "string"
                    },
                    "limit": {
                      "description": "Page size used for this response",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "type": "integer"
                    },
                    "nextCursor": {
                      "description": "Cursor/token for the next page",
                      "type": "string"
                    },
                    "offset": {
                      "description": "Offset used for this page when offset-based paging applies",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
