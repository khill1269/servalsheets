exports[`Schema Snapshots > Input Schemas > GenerateSheetInputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "generate_sheet",
      "description": "Create a structured, formatted spreadsheet from a natural language description",
      "type": "string"
    },
    "context": {
      "description": "Additional context: industry, company size, specific requirements, or data constraints",
      "maxLength": 2000,
      "type": "string"
    },
    "description": {
      "description": "Natural language description of the spreadsheet to create (e.g., \\"Q1 budget tracker with revenue by month, expense categories, and profit margin formulas\\")",
      "maxLength": 2000,
      "minLength": 10,
      "type": "string"
    },
    "safety": {
      "additionalProperties": false,
      "description": "Safety options: dryRun for preview, autoSnapshot for automatic backups",
      "properties": {
        "autoSnapshot": {
          "default": true,
          "type": "boolean"
        },
        "confirmed": {
          "description": "Pre-approval bypass for destructive operations when the MCP client does not support interactive elicitation. Pass true after reviewing the operation details out-of-band. Equivalent to answering \\"Yes, proceed\\" to the elicitation prompt. Has no effect on non-destructive operations.",
          "type": "boolean"
        },
        "dryRun": {
          "default": false,
          "type": "boolean"
        },
        "effectScope": {
          "additionalProperties": false,
          "properties": {
            "maxCellsAffected": {
              "default": 50000,
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "maxColumnsAffected": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "maxRowsAffected": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "requireExplicitRange": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "maxCellsAffected",
            "requireExplicitRange"
          ],
          "type": "object"
        },
        "expectedState": {
          "additionalProperties": false,
          "properties": {
            "checksum": {
              "description": "MD5 hash of range values to verify",
              "type": "string"
            },
            "checksumRange": {
              "description": "A1 range for checksum calculation (default: A1:J10)",
              "type": "string"
            },
            "columnCount": {
              "description": "Expected total column count",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "firstRowValues": {
              "description": "Expected header values in first row",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "rowCount": {
              "description": "Expected total row count",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "sheetTitle": {
              "description": "Sheet title that must exist",
              "type": "string"
            },
            "version": {
              "description": "Specific version to validate",
              "type": "string"
            }
          },
          "type": "object"
        },
        "sanitizeFormulas": {
          "default": true,
          "description": "When true, reject cell values containing dangerous data-exfiltration formulas (IMPORTDATA, IMPORTRANGE, IMPORTFEED, IMPORTHTML, IMPORTXML, GOOGLEFINANCE, QUERY). Returns FORMULA_INJECTION_BLOCKED error if detected.",
          "type": "boolean"
        },
        "transactionId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        }
      },
      "required": [
        "dryRun",
        "autoSnapshot",
        "sanitizeFormulas"
      ],
      "type": "object"
    },
    "sheetName": {
      "description": "Sheet name (auto-generated from description if omitted)",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\\\\\\\/?*[\\\\]]+$",
      "type": "string"
    },
    "spreadsheetId": {
      "description": "Existing spreadsheet to add sheet to (creates new spreadsheet if omitted)",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9-_]+$",
      "type": "string"
    },
    "style": {
      "default": "professional",
      "description": "Visual style preset",
      "enum": [
        "minimal",
        "professional",
        "dashboard"
      ],
      "type": "string"
    },
    "verbosity": {
      "default": "standard",
      "description": "Response detail level",
      "enum": [
        "minimal",
        "standard",
        "detailed"
      ],
      "type": "string"
    }
  },
  "required": [
    "action",
    "description",
    "verbosity"
  ],
  "type": "object"
}"
`;

