              "minimum": 0,
              "type": "integer"
            },
            "totalCount": {
              "description": "Total number of matching records when known",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "hasMore"
          ],
          "type": "object"
        },
        "protocolVersion": {
          "description": "MCP protocol version this server implements (e.g. \\"2025-11-25\\")",
          "type": "string"
        },
        "quotaStatus": {
          "additionalProperties": false,
          "description": "Predictive quota management",
          "properties": {
            "burnRate": {
              "minimum": 0,
              "type": "number"
            },
            "current": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "limit": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "projection": {
              "additionalProperties": false,
              "properties": {
                "confidence": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                "willExceedIn": {
                  "type": "string"
                }
              },
              "required": [
                "willExceedIn",
                "confidence"
              ],
              "type": "object"
            },
            "recommendation": {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "savings": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "reason",
                "savings"
              ],
              "type": "object"
            },
            "remaining": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "resetIn": {
              "type": "string"
            }
          },
          "required": [
            "current",
            "limit",
            "remaining",
            "resetIn",
            "burnRate"
          ],
          "type": "object"
        },
        "relatedTools": {
          "description": "Related tools that might be useful",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retrievalUri": {
          "description": "Resource URI for retrieving full non-truncated payload",
          "type": "string"
        },
        "snapshot": {
          "additionalProperties": false,
          "description": "Snapshot info for undo/rollback",
          "properties": {
            "description": {
              "description": "Human-readable snapshot description",
              "type": "string"
            },
            "metadata": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": "Additional snapshot metadata",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "snapshotId": {
              "description": "Unique snapshot identifier",
              "type": "string"
            },
            "timestamp": {
              "description": "ISO 8601 timestamp of snapshot creation",
              "type": "string"
            }
          },
          "required": [
            "snapshotId",
            "timestamp"
          ],
          "type": "object"
        },
        "suggestions": {
          "description": "Follow-up tool suggestions and optimizations",
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "priority": {
                "default": "medium",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "optimization",
                  "alternative",
                  "follow_up",
                  "warning",
                  "related"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "message",
              "reason",
              "priority"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "summary": {
          "additionalProperties": false,
          "description": "Summary statistics for list-type responses",
          "properties": {
            "byStatus": {
              "additionalProperties": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              "description": "Counts grouped by status",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "total": {
              "description": "Total item count",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "total"
          ],
          "type": "object"
        },
        "truncated": {
          "description": "True when response payload was truncated and full data is available elsewhere",
          "type": "boolean"
        },
        "verificationSummary": {
          "description": "Short verification summary describing what was checked or confirmed",
          "type": "string"
        },
        "warnings": {
          "description": "Safety warnings or considerations",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "action": {
      "const": "publish_report",
      "type": "string"
    },
    "report": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "description": "Report content (CSV text or base64-encoded binary)",
          "type": "string"
        },
        "fileId": {
          "description": "Drive file ID if exported to Drive",
          "type": "string"
        },
        "format": {
          "enum": [
            "pdf",
            "xlsx",
            "csv"
          ],
          "type": "string"
        },
        "generatedAt": {
          "description": "ISO 8601 timestamp of when the report was generated",
          "type": "string"
        },
        "sizeBytes": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "format",
        "generatedAt"
      ],
      "type": "object"
    },
    "success": {
      "const": true,
      "type": "boolean"
    }
  },
  "required": [
    "success",
    "action",
    "report"
  ],
  "type": "object"
}"
`;

