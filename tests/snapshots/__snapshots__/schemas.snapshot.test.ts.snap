              ],
              "type": "object"
            },
            "success": {
              "const": false,
              "type": "boolean"
            }
          },
          "required": [
            "success",
            "error"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "response"
  ],
  "type": "object"
}"
