exports[`Schema Snapshots > Input Schemas > SheetsTransactionInputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "request": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "begin",
              "description": "Begin a new transaction",
              "type": "string"
            },
            "autoRollback": {
              "default": false,
              "description": "Whether to automatically attempt rollback when a queued operation fails during commit (default: false). WARNING: Automatic rollback cannot undo in-place writes — it requires manual recovery via sheets_history action:\\"undo\\" or version restore. Set to true only for non-critical transactions where partial rollback is acceptable.",
              "type": "boolean"
            },
            "autoSnapshot": {
              "default": true,
              "description": "NOTE: Currently ignored — snapshots are controlled by server config. Metadata-only snapshots may fail for spreadsheets with >50MB metadata (spreadsheets with many sheets). For large spreadsheets, use sheets_history action:\\"create_snapshot\\" before the transaction instead.",
              "type": "boolean"
            },
            "isolationLevel": {
              "default": "read_committed",
              "description": "Transaction isolation level (default: read_committed). \\"read_uncommitted\\": reads may see uncommitted changes from other transactions (fastest, least safe). \\"read_committed\\": reads only see committed data (default — recommended for most use cases). \\"serializable\\": full isolation, transactions execute as if sequential (slowest, safest for audits).",
              "enum": [
                "read_uncommitted",
                "read_committed",
                "serializable"
              ],
              "type": "string"
            },
            "spreadsheetId": {
              "description": "Spreadsheet ID from the Google Sheets URL (the long alphanumeric string between /d/ and /edit). All queued operations in this transaction will target this spreadsheet. Example: \\"1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms\\"",
              "minLength": 1,
              "type": "string"
            },
            "verbosity": {
              "default": "standard",
              "description": "Response detail level: minimal (essential info only, ~25-88% fewer tokens; measured mean 62%), standard (balanced), detailed (full metadata)",
              "enum": [
                "minimal",
                "standard",
                "detailed"
              ],
              "type": "string"
            }
          },
          "required": [
            "verbosity",
            "action",
            "spreadsheetId",
            "autoSnapshot",
            "autoRollback",
            "isolationLevel"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "queue",
              "description": "Queue an operation in the transaction",
              "type": "string"
            },
            "operation": {
              "additionalProperties": false,
              "description": "Operation to queue for batch execution",
              "properties": {
                "action": {
                  "description": "Action name (e.g., write, update, format)",
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                "params": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      },
                      {
                        "items": {},
                        "type": "array"
                      },
                      {
                        "additionalProperties": {},
                        "propertyNames": {
                          "type": "string"
                        },
                        "type": "object"
                      }
                    ]
                  },
                  "description": "Operation parameters (string, number, boolean, null, array, or object)",
                  "propertyNames": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "tool": {
                  "description": "Tool name (e.g., sheets_data, sheets_format)",
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "tool",
                "action",
                "params"
              ],
              "type": "object"
            },
            "transactionId": {
              "description": "Transaction ID returned by the begin action. All queued operations with this ID are executed atomically on commit. Example: \\"txn_1709123456789_abc123\\"",
              "minLength": 1,
              "type": "string"
            },
            "verbosity": {
              "default": "standard",
              "description": "Response detail level: minimal (essential info only, ~25-88% fewer tokens; measured mean 62%), standard (balanced), detailed (full metadata)",
              "enum": [
                "minimal",
                "standard",
                "detailed"
              ],
              "type": "string"
            }
          },
          "required": [
            "verbosity",
            "action",
            "transactionId",
            "operation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "commit",
              "description": "Commit a transaction (execute all queued operations)",
              "type": "string"
            },
            "transactionId": {
              "description": "Transaction ID from the begin response. Executes all queued operations in order. Example: \\"txn_1709123456789_abc123\\"",
              "minLength": 1,
              "type": "string"
            },
            "verbosity": {
              "default": "standard",
              "description": "Response detail level: minimal (essential info only, ~25-88% fewer tokens; measured mean 62%), standard (balanced), detailed (full metadata)",
              "enum": [
                "minimal",
                "standard",
                "detailed"
              ],
              "type": "string"
            }
          },
          "required": [
            "verbosity",
            "action",
            "transactionId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "rollback",
              "description": "Rollback a transaction (discard all queued operations)",
              "type": "string"
            },
            "transactionId": {
              "description": "Transaction ID from the begin response. Discards all queued operations without executing them. Safe to call even if the transaction has already failed. Example: \\"txn_1709123456789_abc123\\"",
              "minLength": 1,
              "type": "string"
            },
            "verbosity": {
              "default": "standard",
              "description": "Response detail level: minimal (essential info only, ~25-88% fewer tokens; measured mean 62%), standard (balanced), detailed (full metadata)",
              "enum": [
                "minimal",
                "standard",
                "detailed"
              ],
              "type": "string"
            }
          },
          "required": [
            "verbosity",
            "action",
            "transactionId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "status",
              "description": "Get status of a transaction",
              "type": "string"
            },
            "transactionId": {
              "description": "Transaction ID from the begin response. Returns current status: pending (not yet committed), queued (operations waiting), executing (commit in progress), committed (complete), rolled_back (discarded), or failed. Example: \\"txn_1709123456789_abc123\\"",
              "minLength": 1,
              "type": "string"
            },
            "verbosity": {
              "default": "standard",
              "description": "Response detail level: minimal (essential info only, ~25-88% fewer tokens; measured mean 62%), standard (balanced), detailed (full metadata)",
              "enum": [
                "minimal",
                "standard",
                "detailed"
              ],
              "type": "string"
            }
          },
          "required": [
            "verbosity",
            "action",
            "transactionId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "list",
              "description": "List all active transactions",
              "type": "string"
            },
            "spreadsheetId": {
              "description": "Filter by spreadsheet ID (omit to show all)",
              "minLength": 1,
              "type": "string"
            },
            "verbosity": {
              "default": "standard",
              "description": "Response detail level: minimal (essential info only, ~25-88% fewer tokens; measured mean 62%), standard (balanced), detailed (full metadata)",
              "enum": [
                "minimal",
                "standard",
                "detailed"
              ],
              "type": "string"
            }
          },
          "required": [
            "verbosity",
            "action"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "request"
  ],
  "type": "object"
}"
`;

exports[`Schema Snapshots > Input Schemas > SheetsVisualizeInputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "request": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "chart_create",
              "description": "Create a new chart. Minimal example: { \\"action\\": \\"chart_create\\", \\"spreadsheetId\\": \\"abc123\\", \\"sheetId\\": 0, \\"chartType\\": \\"LINE\\", \\"data\\": { \\"sourceRange\\": \\"Sheet1!A1:B10\\" }, \\"position\\": { \\"anchorCell\\": \\"E2\\", \\"sheetId\\": 0 } }",
              "type": "string"
            },
            "chartType": {
              "description": "Chart type. BAR=horizontal bars, COLUMN=vertical bars. PIE, LINE, SCATTER, AREA, COMBO also available.",
              "enum": [
                "BAR",
                "LINE",
                "AREA",
                "COLUMN",
                "SCATTER",
                "COMBO",
                "STEPPED_AREA",
                "PIE",
                "DOUGHNUT",
                "TREEMAP",
                "WATERFALL",
                "HISTOGRAM",
                "CANDLESTICK",
                "ORG",
                "RADAR",
                "SCORECARD",
                "BUBBLE"
              ],
              "type": "string"
            },
            "data": {
              "additionalProperties": false,
              "description": "Chart data source. NOTE: BAR charts only support BOTTOM_AXIS (horizontal bars). Use COLUMN for vertical bars.",
              "properties": {
                "aggregateType": {
                  "enum": [
                    "AVERAGE",
                    "COUNT",
                    "COUNTA",
                    "COUNTUNIQUE",
                    "MAX",
                    "MEDIAN",
                    "MIN",
                    "STDEV",
                    "STDEVP",
                    "SUM",
                    "VAR",
                    "VARP"
                  ],
                  "type": "string"
                },
                "categories": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "series": {
                  "description": "Data series with optional trendlines and data labels",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "color": {
                        "description": "Series color (RGB)"
                      },
                      "colorStyle": {
                        "anyOf": [
                          {
                            "additionalProperties": false,
                            "description": "Explicit RGB color",
                            "properties": {
                              "rgbColor": {
                                "description": "Color in RGB 0-1 scale, hex (#4285F4), or named (red, blue, google-blue). Examples: {red:1,green:0,blue:0}, \\"#FF0000\\", \\"red\\""
                              }
                            },
                            "required": [
                              "rgbColor"
                            ],
                            "type": "object"
                          },
                          {
                            "additionalProperties": false,
                            "description": "Theme color (auto-updates with spreadsheet theme)",
                            "properties": {
                              "themeColor": {
                                "description": "Theme color that updates with the spreadsheet theme. Values: TEXT, BACKGROUND, ACCENT1-6, LINK",
                                "enum": [
                                  "TEXT",
                                  "BACKGROUND",
                                  "ACCENT1",
                                  "ACCENT2",
                                  "ACCENT3",
                                  "ACCENT4",
                                  "ACCENT5",
                                  "ACCENT6",
                                  "LINK"
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "themeColor"
                            ],
                            "type": "object"
                          }
                        ],
                        "description": "Series color as RGB or theme color"
                      },
                      "column": {
                        "description": "Column index (0-based) for series data",
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "dataLabel": {
                        "additionalProperties": false,
                        "description": "Configure data labels for this series",
                        "properties": {
                          "placement": {
                            "description": "Label position relative to data point",
                            "enum": [
                              "CENTER",
                              "LEFT",
                              "RIGHT",
                              "ABOVE",
                              "BELOW",
                              "INSIDE_END",
                              "INSIDE_BASE",
                              "OUTSIDE_END"
                            ],
                            "type": "string"
                          },
                          "textFormat": {
                            "additionalProperties": false,
                            "description": "Text formatting for labels",
                            "properties": {
                              "bold": {
                                "type": "boolean"
                              },
                              "fontFamily": {
                                "type": "string"
                              },
                              "fontSize": {
                                "exclusiveMinimum": 0,
                                "type": "number"
                              },
                              "foregroundColor": {
                                "description": "Color in RGB 0-1 scale, hex (#4285F4), or named (red, blue, google-blue). Examples: {red:1,green:0,blue:0}, \\"#FF0000\\", \\"red\\""
                              },
                              "foregroundColorStyle": {
                                "anyOf": [
                                  {
                                    "additionalProperties": false,
                                    "description": "Explicit RGB color",
                                    "properties": {
                                      "rgbColor": {
                                        "description": "Color in RGB 0-1 scale, hex (#4285F4), or named (red, blue, google-blue). Examples: {red:1,green:0,blue:0}, \\"#FF0000\\", \\"red\\""
                                      }
                                    },
                                    "required": [
                                      "rgbColor"
                                    ],
                                    "type": "object"
                                  },
                                  {
                                    "additionalProperties": false,
                                    "description": "Theme color (auto-updates with spreadsheet theme)",
                                    "properties": {
                                      "themeColor": {
                                        "description": "Theme color that updates with the spreadsheet theme. Values: TEXT, BACKGROUND, ACCENT1-6, LINK",
                                        "enum": [
                                          "TEXT",
                                          "BACKGROUND",
                                          "ACCENT1",
                                          "ACCENT2",
                                          "ACCENT3",
                                          "ACCENT4",
                                          "ACCENT5",
                                          "ACCENT6",
                                          "LINK"
                                        ],
                                        "type": "string"
                                      }
                                    },
                                    "required": [
                                      "themeColor"
                                    ],
                                    "type": "object"
                                  }
                                ],
                                "description": "Text color as ColorStyle (preferred over foregroundColor; supports theme colors)"
                              },
                              "italic": {
                                "type": "boolean"
                              },
                              "strikethrough": {
                                "type": "boolean"
                              },
                              "underline": {
                                "type": "boolean"
                              }
                            },
                            "type": "object"
                          },
                          "type": {
                            "default": "DATA",
                            "description": "What to label: DATA (values), CUSTOM (from range), NONE",
                            "enum": [
                              "NONE",
                              "DATA",
                              "CUSTOM"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "type": "object"
                      },
                      "trendline": {
                        "additionalProperties": false,
                        "description": "Add trendline to this series",
                        "properties": {
                          "color": {
                            "description": "Trendline color (defaults to series color)"
                          },
                          "label": {
                            "description": "Custom label for trendline",
                            "maxLength": 255,
                            "type": "string"
                          },
                          "polynomialDegree": {
                            "description": "Degree for POLYNOMIAL type. Required when type=POLYNOMIAL. Typical values: 2 (quadratic), 3 (cubic). Higher values (4-6) risk overfitting. Omitting this when type=POLYNOMIAL will cause an error.",
                            "maximum": 6,
                            "minimum": 2,
                            "type": "integer"
                          },
                          "showEquation": {
                            "default": false,
                            "description": "Display regression equation on chart",
                            "type": "boolean"
                          },
                          "showRSquared": {
                            "default": false,
                            "description": "Display R-squared value on chart",
                            "type": "boolean"
                          },
                          "type": {
                            "description": "Trendline type",
                            "enum": [
                              "LINEAR",
                              "EXPONENTIAL",
                              "POLYNOMIAL",
                              "POWER",
                              "LOGARITHMIC",
                              "MOVING_AVERAGE"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "showEquation",
                          "showRSquared"
                        ],
                        "type": "object"
                      }
                    },
                    "required": [
                      "column"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "sourceRange": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "description": "A1 notation range, e.g. \\"Sheet1!A1:D10\\"",
                          "properties": {
                            "a1": {
                              "description": "A1 notation range: \\"A1\\" (single cell), \\"A1:C10\\" (range), \\"Sheet1!A1:C10\\" (with sheet name). Full column refs (A:Z) are rejected — always include row numbers.",
                              "maxLength": 500,
                              "minLength": 1,
                              "pattern": "^[^[\\\\]]+$",
                              "type": "string"
                            }
                          },
                          "required": [
                            "a1"
                          ],
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "description": "Named range identifier, e.g. \\"SalesData\\"",
                          "properties": {
                            "namedRange": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "namedRange"
                          ],
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "description": "Natural language range description",
                          "properties": {
                            "semantic": {
                              "additionalProperties": false,
                              "properties": {
                                "column": {
                                  "type": "string"
                                },
                                "includeHeader": {
                                  "default": false,
                                  "type": "boolean"
                                },
                                "rowEnd": {
                                  "maximum": 9007199254740991,
                                  "minimum": 1,
                                  "type": "integer"
                                },
                                "rowStart": {
                                  "maximum": 9007199254740991,
                                  "minimum": 1,
                                  "type": "integer"
                                },
                                "sheet": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "sheet",
                                "column",
                                "includeHeader"
                              ],
                              "type": "object"
                            }
                          },
                          "required": [
                            "semantic"
                          ],
                          "type": "object"
                        },
                        {
                          "additionalProperties": false,
                          "description": "Grid coordinate range: { sheetId: number, startRowIndex?: number (0-based), endRowIndex?: number (exclusive), startColumnIndex?: number (0-based), endColumnIndex?: number (exclusive) }",
                          "properties": {
                            "grid": {
                              "additionalProperties": false,
                              "properties": {
                                "endColumnIndex": {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                },
                                "endRowIndex": {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                },
                                "sheetId": {
                                  "description": "Numeric sheet/tab ID (e.g., 0 for first sheet, found in URL #gid=123456789). Use sheets_core get to retrieve sheet IDs.",
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                },
                                "startColumnIndex": {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                },
                                "startRowIndex": {
                                  "maximum": 9007199254740991,
                                  "minimum": 0,
                                  "type": "integer"
                                }
                              },
                              "required": [
                                "sheetId"
                              ],
                              "type": "object"
                            }
                          },
                          "required": [
                            "grid"
                          ],
                          "type": "object"
                        }
                      ],
                      "description": "Range input. Accepts A1 string (auto-wrapped to {a1}), {a1:'Sheet1!A1:B10'}, {namedRange:'MyRange'}, {semantic:{sheet,column,rowStart?,rowEnd?}} (resilient to renames), or {grid:{sheetId,startRowIndex,...}}. Prefer namedRange or semantic for durability across schema changes."
                    },
                    {
                      "description": "A1 notation range(s). For multiple ranges, use comma-separated: \\"Sheet1!A1:A10,Sheet1!D1:D10\\""
                    }
                  ],
                  "description": "Chart data source. Accepts A1 notation, comma-separated ranges for multi-series, or structured input {a1: \\"...\\"}."
                }
              },
              "required": [
                "sourceRange"
              ],
              "type": "object"
            },
            "options": {
              "additionalProperties": false,
              "description": "Chart options (title, subtitle, legend, colors, 3D, stacking, etc.)",
              "properties": {
                "axes": {
                  "additionalProperties": false,
                  "description": "Axis configuration. Example: { axes: { vertical: { title: \\"Revenue\\", min: 0, max: 1000000 } } }",
                  "properties": {
                    "horizontal": {
                      "additionalProperties": false,
                      "description": "Horizontal (X / BOTTOM_AXIS) configuration",
                      "properties": {
                        "max": {
                          "description": "Maximum value for axis (sets viewWindowMode to EXPLICIT)",
                          "type": "number"
                        },
                        "min": {
                          "description": "Minimum value for axis (sets viewWindowMode to EXPLICIT)",
                          "type": "number"
                        },
                        "title": {
                          "description": "Axis title label",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "vertical": {
                      "additionalProperties": false,
                      "description": "Vertical (Y / LEFT_AXIS) configuration",
                      "properties": {
                        "max": {
                          "description": "Maximum value for axis (sets viewWindowMode to EXPLICIT)",
                          "type": "number"
                        },
                        "min": {
                          "description": "Minimum value for axis (sets viewWindowMode to EXPLICIT)",
                          "type": "number"
                        },
                        "title": {
                          "description": "Axis title label",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                "axisTitle": {
                  "additionalProperties": false,
                  "description": "Axis titles (deprecated: use axes.horizontal.title / axes.vertical.title)",
                  "properties": {
                    "horizontal": {
                      "type": "string"
                    },
                    "vertical": {
                      "type": "string"
                    }
                  },
                  "type": "object"
