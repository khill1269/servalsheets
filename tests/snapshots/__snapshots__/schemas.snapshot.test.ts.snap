            "CHECKPOINT_NOT_FOUND",
            "PAYLOAD_TOO_LARGE",
            "OPERATION_LIMIT_EXCEEDED",
            "ELICITATION_UNAVAILABLE",
            "SAMPLING_UNAVAILABLE",
            "FORBIDDEN",
            "DISCOVERY_FAILED",
            "REPLAY_FAILED",
            "UNKNOWN_ERROR",
            "INVALID_ACTION",
            "CONNECTOR_ERROR",
            "SESSION_ERROR",
            "QUERY_REJECTED",
            "LOCK_TIMEOUT",
            "TASK_CANCELLED"
          ],
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {}
            ]
          },
          "description": "Error details as key-value pairs with primitive or generic values",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "fixableVia": {
          "additionalProperties": false,
          "description": "Structured fix suggestion with tool/action to resolve the error",
          "properties": {
            "action": {
              "description": "Action name to fix the issue",
              "type": "string"
            },
            "explanation": {
              "description": "Same string as \`suggestedFix\`; duplicated here for callers that only read fixableVia",
              "type": "string"
            },
            "params": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "items": {},
                    "type": "array"
                  },
                  {
                    "additionalProperties": {},
                    "propertyNames": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": "Suggested parameters for the fix action",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "tool": {
              "description": "Tool name to fix the issue",
              "type": "string"
            }
          },
          "required": [
            "tool",
            "action"
          ],
          "type": "object"
        },
        "message": {
          "type": "string"
        },
        "resolution": {
          "description": "Recommended resolution strategy",
          "type": "string"
        },
        "resolutionSteps": {
          "description": "Step-by-step instructions to resolve the error",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resources": {
          "description": "Resource URIs for error guidance (e.g., servalsheets://decisions/find-sheet, servalsheets://reference/authentication)",
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "uri": {
                "type": "string"
              }
            },
            "required": [
              "uri",
              "description"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        },
        "retryAfterMs": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "retryStrategy": {
          "description": "Recommended retry strategy",
          "enum": [
            "exponential_backoff",
            "wait_for_reset",
            "manual",
            "reauthorize",
            "none"
          ],
          "type": "string"
        },
        "severity": {
          "description": "Error severity level",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "type": "string"
        },
        "suggestedFix": {
          "description": "Human-readable fix hint. For the structured, LLM-executable shape use \`fixableVia\`.",
          "type": "string"
        },
        "suggestedTools": {
          "description": "Tools that might help resolve this error",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "success": {
      "const": false,
      "type": "boolean"
    }
  },
  "required": [
    "success",
    "error"
  ],
  "type": "object"
}"
`;

