                      "type": "integer"
                    },
                    "sheetTitle": {
                      "description": "Sheet title that must exist",
                      "type": "string"
                    },
                    "version": {
                      "description": "Specific version to validate",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "sanitizeFormulas": {
                  "default": true,
                  "description": "When true, reject cell values containing dangerous data-exfiltration formulas (IMPORTDATA, IMPORTRANGE, IMPORTFEED, IMPORTHTML, IMPORTXML, GOOGLEFINANCE, QUERY). Returns FORMULA_INJECTION_BLOCKED error if detected.",
                  "type": "boolean"
                },
                "transactionId": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string"
                }
              },
              "required": [
                "dryRun",
                "autoSnapshot",
                "sanitizeFormulas"
              ],
              "type": "object"
            },
            "sheetId": {
              "description": "Numeric sheet ID where rule will be applied",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "spreadsheetId": {
              "description": "Spreadsheet ID from URL",
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9-_]+$",
              "type": "string"
            },
            "verbosity": {
              "default": "standard",
              "description": "Response detail level: minimal (essential info only, ~50% less tokens), standard (balanced), detailed (full metadata)",
              "enum": [
                "minimal",
                "standard",
                "detailed"
              ],
              "type": "string"
            }
          },
          "required": [
            "spreadsheetId",
            "verbosity",
            "action",
            "description",
            "range",
            "sheetId",
            "applyImmediately"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Create dependent dropdown validation where the options in column B depend on the selection in column A. Handles the full workflow: reads unique parent values from lookup table, creates named ranges for each parent group, sets INDIRECT formula-based validation on the dependent column. Requires a lookup table sheet where column A = parent values and columns B+ = child options per parent. Example: parentRange:\\"Sheet1!A2:A100\\" dependentRange:\\"Sheet1!B2:B100\\" lookupSheet:\\"Lookup\\"",
          "properties": {
            "action": {
              "const": "build_dependent_dropdown",
              "type": "string"
            },
            "dependentRange": {
              "description": "A1 notation range of the dependent (level-2) dropdown cells. Each cell in this range will show options based on the corresponding parent cell. Must be same number of rows as parentRange. Example: \\"Sheet1!B2:B100\\"",
              "type": "string"
            },
            "lookupSheet": {
              "description": "Name of the lookup table sheet. Column A must contain parent values. Subsequent columns contain child options for each parent. Example: A1=USA, B1=California, C1=Texas / A2=Canada, B2=Ontario, C2=Quebec. Sheet name: \\"Lookup\\"",
              "type": "string"
            },
            "parentRange": {
              "description": "A1 notation range of the parent (level-1) dropdown cells. These cells will get a simple dropdown of unique values from the lookup table. Example: \\"Sheet1!A2:A100\\"",
              "type": "string"
            },
            "spreadsheetId": {
              "description": "ID of the spreadsheet. Example: \\"1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms\\"",
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9-_]+$",
              "type": "string"
            },
            "verbosity": {
              "default": "standard",
              "description": "Response detail level",
              "enum": [
                "minimal",
                "standard",
                "detailed"
              ],
              "type": "string"
            }
          },
          "required": [
            "action",
            "spreadsheetId",
            "parentRange",
            "dependentRange",
            "lookupSheet",
            "verbosity"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "request"
  ],
  "type": "object"
}"
`;

