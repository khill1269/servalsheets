            },
            "timestamp": {
              "description": "ISO 8601 timestamp of snapshot creation",
              "type": "string"
            }
          },
          "required": [
            "snapshotId",
            "timestamp"
          ],
          "type": "object"
        },
        "suggestions": {
          "description": "Follow-up tool suggestions and optimizations",
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "priority": {
                "default": "medium",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "optimization",
                  "alternative",
                  "follow_up",
                  "warning",
                  "related"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "message",
              "reason",
              "priority"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "summary": {
          "additionalProperties": false,
          "description": "Summary statistics for list-type responses",
          "properties": {
            "byStatus": {
              "additionalProperties": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              "description": "Counts grouped by status",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "total": {
              "description": "Total item count",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "total"
          ],
          "type": "object"
        },
        "truncated": {
          "description": "True when response payload was truncated and full data is available elsewhere",
          "type": "boolean"
        },
        "verificationSummary": {
          "description": "Short verification summary describing what was checked or confirmed",
          "type": "string"
        },
        "warnings": {
          "description": "Safety warnings or considerations",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "action": {
      "const": "audit_sheet",
      "type": "string"
    },
    "audit": {
      "additionalProperties": false,
      "properties": {
        "blankCells": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "dataCells": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "formulaCells": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "issues": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "location": {
                "description": "Cell or range where the issue was found",
                "type": "string"
              },
              "message": {
                "description": "Human-readable description of the issue",
                "type": "string"
              },
              "type": {
                "description": "Issue type (e.g., empty_header, mixed_types, potential_circular_ref)",
                "type": "string"
              }
            },
            "required": [
              "type",
              "location",
              "message"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "sheetsAudited": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "totalCells": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "totalCells",
        "formulaCells",
        "blankCells",
        "dataCells",
        "sheetsAudited",
        "issues"
      ],
      "type": "object"
    },
    "success": {
      "const": true,
      "type": "boolean"
    }
  },
  "required": [
    "success",
    "action",
    "audit"
  ],
  "type": "object"
}"
`;

