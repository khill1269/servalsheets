                  "type": "string"
                },
                "severity": {
                  "description": "Error severity level",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "critical"
                  ],
                  "type": "string"
                },
                "suggestedFix": {
                  "description": "Human-readable fix hint. For the structured, LLM-executable shape use \`fixableVia\`.",
                  "type": "string"
                },
                "suggestedTools": {
                  "description": "Tools that might help resolve this error",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "type": "object"
            },
            "success": {
              "const": false,
              "type": "boolean"
            }
          },
          "required": [
            "success",
            "error"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "response"
  ],
  "type": "object"
}"
