exports[`Schema Snapshots > Output Schemas > ImportXlsxOutputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "additionalProperties": false,
          "description": "Standardized list envelope metadata",
          "properties": {
            "count": {
              "description": "Number of items in the current response page",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "hasMore": {
              "description": "True when more pages are available",
              "type": "boolean"
            },
            "itemsField": {
              "description": "Field name on response containing the current page item array",
              "minLength": 1,
              "type": "string"
            },
            "limit": {
              "description": "Page size used for this response",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "nextCursor": {
              "description": "Cursor/token for the next page",
              "type": "string"
