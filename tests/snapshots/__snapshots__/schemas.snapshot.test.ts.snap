                      "description": "Field name on response containing the current page item array",
                      "minLength": 1,
                      "type": "string"
                    },
                    "limit": {
                      "description": "Page size used for this response",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "type": "integer"
                    },
