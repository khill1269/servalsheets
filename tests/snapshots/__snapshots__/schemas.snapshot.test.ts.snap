                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": "Additional snapshot metadata",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "snapshotId": {
              "description": "Unique snapshot identifier",
              "type": "string"
            },
            "timestamp": {
              "description": "ISO 8601 timestamp of snapshot creation",
              "type": "string"
            }
          },
          "required": [
            "snapshotId",
            "timestamp"
          ],
          "type": "object"
        },
        "suggestions": {
          "description": "Follow-up tool suggestions and optimizations",
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "priority": {
                "default": "medium",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "optimization",
                  "alternative",
                  "follow_up",
                  "warning",
                  "related"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "message",
              "reason",
              "priority"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "summary": {
          "additionalProperties": false,
          "description": "Summary statistics for list-type responses",
          "properties": {
            "byStatus": {
              "additionalProperties": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              "description": "Counts grouped by status",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "total": {
              "description": "Total item count",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "total"
          ],
          "type": "object"
        },
        "truncated": {
          "description": "True when response payload was truncated and full data is available elsewhere",
          "type": "boolean"
        },
        "verificationSummary": {
          "description": "Short verification summary describing what was checked or confirmed",
          "type": "string"
        },
        "warnings": {
          "description": "Safety warnings or considerations",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "action": {
      "const": "export_large_dataset",
      "type": "string"
    },
    "bytesProcessed": {
      "description": "Total bytes processed",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "chunkSize": {
      "description": "Chunk size used for export",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "chunksProcessed": {
      "description": "Number of chunks processed",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "data": {
      "description": "Exported data (JSON string or CSV string)",
      "type": "string"
    },
    "durationMs": {
      "description": "Export duration in milliseconds",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "format": {
      "description": "Output format used",
      "enum": [
        "json",
        "csv"
      ],
      "type": "string"
    },
    "streamed": {
      "description": "Whether streaming was used",
      "type": "boolean"
    },
    "success": {
      "const": true,
      "type": "boolean"
    },
    "totalColumns": {
      "description": "Total columns exported",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "totalRows": {
      "description": "Total rows exported",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "success",
    "action",
    "format",
    "totalRows",
    "totalColumns",
    "chunksProcessed",
    "bytesProcessed",
    "durationMs",
    "streamed",
    "data"
  ],
  "type": "object"
}"
`;

