            "AUTH_ERROR",
            "CONFIG_ERROR",
            "NOT_CONFIGURED",
            "VALIDATION_ERROR",
            "NOT_FOUND",
            "NOT_IMPLEMENTED",
            "HANDLER_LOAD_ERROR",
            "TOO_MANY_SESSIONS",
            "DATA_ERROR",
            "VERSION_MISMATCH",
            "NO_DATA",
            "SERVICE_NOT_INITIALIZED",
            "SERVICE_NOT_ENABLED",
            "SNAPSHOT_CREATION_FAILED",
            "SNAPSHOT_RESTORE_FAILED",
            "TRANSACTION_CONFLICT",
            "TRANSACTION_EXPIRED",
            "SESSION_NOT_FOUND",
            "CHECKPOINTS_DISABLED",
            "CHECKPOINT_NOT_FOUND",
            "PAYLOAD_TOO_LARGE",
            "OPERATION_LIMIT_EXCEEDED",
            "ELICITATION_UNAVAILABLE",
            "SAMPLING_UNAVAILABLE",
            "FORBIDDEN",
            "DISCOVERY_FAILED",
            "REPLAY_FAILED",
            "UNKNOWN_ERROR",
            "INVALID_ACTION",
            "CONNECTOR_ERROR",
            "SESSION_ERROR",
            "QUERY_REJECTED",
            "LOCK_TIMEOUT",
            "TASK_CANCELLED"
          ],
          "type": "string"
        },
        "errorCodeFamily": {
          "description": "Coarse error-code family for analytics and migration-safe client handling",
          "enum": [
            "protocol",
            "validation",
            "authentication",
            "authorization",
            "quota",
            "not_found",
            "conflict",
            "precondition",
            "transport",
            "service",
            "feature",
            "session",
            "data",
            "unknown"
          ],
          "type": "string"
        },
        "errorCodeIsAlias": {
          "description": "True when errorCode differs from errorCodeCanonical",
          "type": "boolean"
        },
        "journeyStage": {
          "description": "User journey stage this response belongs to",
          "enum": [
            "onboarding",
            "readiness",
            "authentication",
            "connector_setup",
            "first_success",
            "mutation",
            "recovery"
          ],
          "type": "string"
        },
        "nextBestAction": {
          "description": "Single next action that will make the most progress for the user",
          "type": "string"
        },
        "nextSteps": {
          "description": "Recommended next steps",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "originalSizeBytes": {
          "description": "Original serialized response size before truncation",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "pagination": {
          "additionalProperties": false,
          "description": "Standardized pagination metadata envelope",
          "properties": {
            "count": {
              "description": "Number of records returned in the current page",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "hasMore": {
              "description": "True when additional pages are available",
              "type": "boolean"
            },
            "limit": {
              "description": "Page size used for this response",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "nextCursor": {
              "description": "Opaque cursor/page token to request the next page",
              "type": "string"
            },
            "offset": {
              "description": "Offset used for this page when offset-based pagination is used",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "totalCount": {
              "description": "Total number of matching records when known",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "hasMore"
          ],
          "type": "object"
        },
        "protocolVersion": {
          "description": "MCP protocol version this server implements (e.g. \\"2025-11-25\\")",
          "type": "string"
        },
        "quotaStatus": {
          "additionalProperties": false,
          "description": "Predictive quota management",
          "properties": {
            "burnRate": {
              "minimum": 0,
              "type": "number"
            },
            "current": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "limit": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "projection": {
              "additionalProperties": false,
              "properties": {
                "confidence": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                "willExceedIn": {
                  "type": "string"
                }
              },
              "required": [
                "willExceedIn",
                "confidence"
              ],
              "type": "object"
            },
            "recommendation": {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "savings": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "reason",
                "savings"
              ],
              "type": "object"
            },
            "remaining": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "resetIn": {
              "type": "string"
            }
          },
          "required": [
            "current",
            "limit",
            "remaining",
            "resetIn",
            "burnRate"
          ],
          "type": "object"
        },
        "relatedTools": {
          "description": "Related tools that might be useful",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retrievalUri": {
          "description": "Resource URI for retrieving full non-truncated payload",
          "type": "string"
        },
        "snapshot": {
          "additionalProperties": false,
          "description": "Snapshot info for undo/rollback",
          "properties": {
            "description": {
              "description": "Human-readable snapshot description",
              "type": "string"
            },
            "metadata": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": "Additional snapshot metadata",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "snapshotId": {
              "description": "Unique snapshot identifier",
              "type": "string"
            },
            "timestamp": {
              "description": "ISO 8601 timestamp of snapshot creation",
              "type": "string"
            }
          },
          "required": [
            "snapshotId",
            "timestamp"
          ],
          "type": "object"
        },
        "suggestions": {
          "description": "Follow-up tool suggestions and optimizations",
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "priority": {
                "default": "medium",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "optimization",
                  "alternative",
                  "follow_up",
                  "warning",
                  "related"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "message",
              "reason",
              "priority"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "summary": {
          "additionalProperties": false,
          "description": "Summary statistics for list-type responses",
          "properties": {
            "byStatus": {
              "additionalProperties": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              "description": "Counts grouped by status",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "total": {
              "description": "Total item count",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "total"
          ],
          "type": "object"
        },
        "truncated": {
          "description": "True when response payload was truncated and full data is available elsewhere",
          "type": "boolean"
        },
        "verificationSummary": {
          "description": "Short verification summary describing what was checked or confirmed",
          "type": "string"
        },
        "warnings": {
          "description": "Safety warnings or considerations",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "action": {
      "const": "clone_structure",
      "type": "string"
    },
    "apiCallsSaved": {
      "description": "Number of API calls saved vs manual process",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "columnCount": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "formattingCopied": {
      "type": "boolean"
    },
    "headerRowsPreserved": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "newSheetId": {
      "description": "Numeric sheet/tab ID (e.g., 0 for first sheet, found in URL #gid=123456789). Use sheets_core get to retrieve sheet IDs.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "newSheetName": {
      "description": "Sheet/tab name (no special chars: \\\\ / ? * [ ])",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\\\\\\\/?*[\\\\]]+$",
      "type": "string"
    },
    "success": {
      "const": true,
      "type": "boolean"
    },
    "validationCopied": {
      "type": "boolean"
    }
  },
  "required": [
    "success",
    "action",
    "newSheetId",
    "newSheetName",
    "columnCount",
    "headerRowsPreserved",
    "formattingCopied",
    "validationCopied",
    "apiCallsSaved"
  ],
  "type": "object"
}"
`;

