          ],
          "type": "object"
        },
        "protocolVersion": {
          "description": "MCP protocol version this server implements (e.g. \\"2025-11-25\\")",
          "type": "string"
        },
        "quotaStatus": {
          "additionalProperties": false,
          "description": "Predictive quota management",
          "properties": {
            "burnRate": {
              "minimum": 0,
              "type": "number"
            },
            "current": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "limit": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "projection": {
              "additionalProperties": false,
              "properties": {
                "confidence": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                "willExceedIn": {
                  "type": "string"
                }
              },
              "required": [
                "willExceedIn",
                "confidence"
              ],
              "type": "object"
            },
            "recommendation": {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "savings": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "reason",
                "savings"
              ],
              "type": "object"
            },
            "remaining": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "resetIn": {
              "type": "string"
            }
          },
          "required": [
            "current",
            "limit",
            "remaining",
            "resetIn",
            "burnRate"
          ],
          "type": "object"
        },
        "relatedTools": {
          "description": "Related tools that might be useful",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retrievalUri": {
          "description": "Resource URI for retrieving full non-truncated payload",
          "type": "string"
        },
        "snapshot": {
          "additionalProperties": false,
          "description": "Snapshot info for undo/rollback",
          "properties": {
            "description": {
              "description": "Human-readable snapshot description",
