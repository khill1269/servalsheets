                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "current",
                "limit",
                "remaining"
              ],
              "type": "object"
            }
          },
          "required": [
            "apiCalls",
            "estimatedLatencyMs"
          ],
          "type": "object"
        },
        "deliveredSizeBytes": {
          "description": "Serialized size of the delivered truncated payload",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "deprecationWarning": {
          "description": "Present when the client used a legacy invocation pattern. Contains migration guidance.",
          "type": "string"
        },
        "documentation": {
          "description": "URL to relevant documentation",
          "pattern": "^(?:https?|redis|rediss):\\\\/\\\\/(?:(?:www\\\\.)?[-a-zA-Z0-9@:%._+~#=]{1,256}\\\\.[a-zA-Z0-9()]{1,6}|localhost|(?:\\\\d{1,3}\\\\.){3}\\\\d{1,3})(?::\\\\d{1,5})?(?:[-a-zA-Z0-9()@:%_+.~#?&/=]*)$",
          "type": "string"
        },
        "errorCode": {
          "description": "Original error code reported by the handler when success=false",
          "enum": [
            "PARSE_ERROR",
            "INVALID_REQUEST",
            "METHOD_NOT_FOUND",
            "INVALID_PARAMS",
            "INTERNAL_ERROR",
