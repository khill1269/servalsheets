exports[`Schema Snapshots > Input Schemas > AuditSheetInputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "audit_sheet",
      "description": "Generate a comprehensive audit report for a spreadsheet",
      "type": "string"
    },
    "includeFormulas": {
      "default": true,
      "description": "Count and report formula cells",
      "type": "boolean"
    },
    "includeStats": {
      "default": true,
      "description": "Include per-column statistics",
      "type": "boolean"
    },
    "sheetName": {
      "description": "Audit a specific sheet (audits all sheets if omitted)",
      "type": "string"
    },
    "spreadsheetId": {
      "description": "Spreadsheet ID to audit",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9-_]+$",
      "type": "string"
    },
    "verbosity": {
      "default": "standard",
      "description": "Response detail level",
      "enum": [
        "minimal",
        "standard",
        "detailed"
      ],
      "type": "string"
    }
  },
  "required": [
    "action",
    "spreadsheetId",
    "includeFormulas",
    "includeStats",
    "verbosity"
  ],
  "type": "object"
}"
`;

exports[`Schema Snapshots > Input Schemas > BatchOperationsInputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "batch_operations",
      "description": "Execute multiple actions in a single tool call",
      "type": "string"
    },
    "atomic": {
      "default": false,
      "description": "If true, all operations succeed or all roll back (requires active session)",
      "type": "boolean"
    },
    "operations": {
      "description": "Operations to execute sequentially (max 20)",
      "items": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "description": "Action name (e.g., \\"write\\")",
            "minLength": 1,
            "type": "string"
          },
          "params": {
            "additionalProperties": {},
            "description": "Action-specific parameters (spreadsheetId auto-injected)",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "tool": {
            "description": "Target tool name (e.g., \\"sheets_data\\")",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "tool",
          "action",
          "params"
        ],
        "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    },
    "spreadsheetId": {
      "description": "Spreadsheet ID (auto-injected into each operation)",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9-_]+$",
      "type": "string"
    },
    "stopOnError": {
      "default": true,
      "description": "If true, halt on first failure; if false, continue and report all results",
      "type": "boolean"
    },
    "verbosity": {
      "default": "standard",
      "description": "Response detail level",
      "enum": [
        "minimal",
        "standard",
        "detailed"
      ],
      "type": "string"
    }
  },
  "required": [
    "action",
    "spreadsheetId",
    "operations",
    "atomic",
    "stopOnError",
    "verbosity"
  ],
  "type": "object"
}"
`;

exports[`Schema Snapshots > Input Schemas > BuildDashboardInputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Build a complete analytics dashboard sheet with KPI metrics, charts, and optional slicers. Creates a new sheet tab with formatted KPI row, embedded charts, and filter controls. Example: build_dashboard dataSheet:\\"Sales\\" layout:\\"full_analytics\\" kpis:[{ label:\\"Revenue\\", formula:\\"=SUM('Sales'!B:B)\\", format:\\"currency\\" }]",
  "properties": {
    "action": {
      "const": "build_dashboard",
      "type": "string"
    },
    "charts": {
      "description": "Charts to embed in the dashboard.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "dataRange": {
            "description": "A1 notation range for chart data. Example: \\"'Sales Data'!A1:B12\\"",
            "type": "string"
          },
          "title": {
            "description": "Chart title. Example: \\"Monthly Revenue\\"",
            "type": "string"
          },
          "type": {
            "description": "Chart type. Examples: BAR, LINE, PIE, COLUMN, SCATTER",
            "type": "string"
          }
        },
        "required": [
          "type",
          "dataRange",
          "title"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "dashboardSheet": {
      "default": "Dashboard",
      "description": "Name for the new dashboard sheet tab to create. Will be created if it does not exist. Default: \\"Dashboard\\"",
      "type": "string"
    },
    "dataSheet": {
      "description": "Name of the sheet tab containing the source data to visualize. This sheet must already exist with data. Example: \\"Sales Data\\"",
      "type": "string"
    },
    "kpis": {
      "description": "KPI metrics to display in the header row. Each becomes a labeled metric cell. Example: [{ label: \\"Revenue\\", formula: \\"=SUM(B:B)\\", format: \\"currency\\" }]",
      "items": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "default": "number",
            "description": "Number format for the KPI value display.",
            "enum": [
              "currency",
              "percentage",
              "number",
              "date"
            ],
            "type": "string"
          },
          "formula": {
            "description": "Google Sheets formula for the KPI value. Must include = prefix. Example: \\"=SUM('Sales Data'!B:B)\\"",
            "type": "string"
          },
          "label": {
            "description": "Display label for the KPI. Example: \\"Total Revenue\\"",
            "type": "string"
          }
        },
        "required": [
          "label",
          "formula",
          "format"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "layout": {
      "default": "full_analytics",
      "description": "Dashboard layout style. \\"kpi_header\\": KPI metrics row at top only. \\"full_analytics\\": KPIs + charts + slicers (recommended). \\"executive_summary\\": Condensed single-page summary.",
      "enum": [
        "kpi_header",
        "full_analytics",
        "executive_summary"
      ],
      "type": "string"
    },
    "slicers": {
      "description": "Interactive filter slicers to add below charts.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "filterColumn": {
            "description": "0-based column index to filter on. Column A = 0, B = 1, etc.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "description": "Slicer title. Example: \\"Filter by Region\\"",
            "type": "string"
          }
        },
        "required": [
          "filterColumn",
          "title"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "spreadsheetId": {
      "description": "ID of the spreadsheet containing the data source. Example: \\"1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms\\"",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9-_]+$",
      "type": "string"
    },
    "verbosity": {
      "default": "standard",
      "description": "Response detail level",
      "enum": [
        "minimal",
        "standard",
        "detailed"
      ],
      "type": "string"
    }
  },
  "required": [
    "action",
    "spreadsheetId",
    "dataSheet",
    "dashboardSheet",
    "layout",
    "verbosity"
  ],
  "type": "object"
}"
`;

exports[`Schema Snapshots > Input Schemas > BulkUpdateInputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "bulk_update",
      "description": "Update rows by matching a key column",
      "type": "string"
    },
    "createUnmatched": {
      "default": false,
      "description": "Create new rows for unmatched keys (default: false | set true to insert missing rows)",
      "type": "boolean"
    },
    "keyColumn": {
      "description": "Column header to match rows by",
      "minLength": 1,
      "type": "string"
    },
    "safety": {
      "additionalProperties": false,
      "description": "Safety options: dryRun for preview, autoSnapshot for automatic backups",
      "properties": {
        "autoSnapshot": {
          "default": true,
          "type": "boolean"
        },
        "confirmed": {
          "description": "Pre-approval bypass for destructive operations when the MCP client does not support interactive elicitation. Pass true after reviewing the operation details out-of-band. Equivalent to answering \\"Yes, proceed\\" to the elicitation prompt. Has no effect on non-destructive operations.",
          "type": "boolean"
        },
        "dryRun": {
          "default": false,
          "type": "boolean"
        },
        "effectScope": {
          "additionalProperties": false,
          "properties": {
            "maxCellsAffected": {
              "default": 50000,
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "maxColumnsAffected": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "maxRowsAffected": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "requireExplicitRange": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "maxCellsAffected",
            "requireExplicitRange"
          ],
          "type": "object"
        },
        "expectedState": {
          "additionalProperties": false,
          "properties": {
            "checksum": {
              "description": "MD5 hash of range values to verify",
              "type": "string"
            },
            "checksumRange": {
              "description": "A1 range for checksum calculation (default: A1:J10)",
              "type": "string"
            },
            "columnCount": {
              "description": "Expected total column count",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "firstRowValues": {
              "description": "Expected header values in first row",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "rowCount": {
              "description": "Expected total row count",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "sheetTitle": {
              "description": "Sheet title that must exist",
              "type": "string"
            },
            "version": {
              "description": "Specific version to validate",
              "type": "string"
            }
          },
          "type": "object"
        },
        "sanitizeFormulas": {
          "default": true,
          "description": "When true, reject cell values containing dangerous data-exfiltration formulas (IMPORTDATA, IMPORTRANGE, IMPORTFEED, IMPORTHTML, IMPORTXML, GOOGLEFINANCE, QUERY). Returns FORMULA_INJECTION_BLOCKED error if detected.",
          "type": "boolean"
        },
        "transactionId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        }
      },
      "required": [
        "dryRun",
        "autoSnapshot",
        "sanitizeFormulas"
      ],
      "type": "object"
    },
    "sheet": {
      "anyOf": [
        {
          "description": "Sheet name",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\\\\\\\/?*[\\\\]]+$",
          "type": "string"
        },
        {
          "description": "Sheet ID",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      ],
      "description": "Target sheet - name or ID"
    },
    "spreadsheetId": {
      "description": "Spreadsheet ID from URL",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9-_]+$",
      "type": "string"
    },
    "updates": {
      "description": "Array of objects with key column and update values (can be string, number, boolean, null, array, or object)",
      "items": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "additionalProperties": {},
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          ]
        },
        "propertyNames": {
          "type": "string"
        },
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "verbosity": {
      "default": "standard",
      "description": "Response detail level: minimal (essential info only, measured 25-88% fewer tokens per response, mean ~62% across 5 shapes — see tests/benchmarks/verbosity-token-reduction.test.ts), standard (balanced), detailed (full metadata)",
      "enum": [
        "minimal",
        "standard",
        "detailed"
      ],
      "type": "string"
    }
  },
  "required": [
    "action",
    "spreadsheetId",
    "sheet",
    "keyColumn",
    "updates",
    "createUnmatched",
    "verbosity"
  ],
  "type": "object"
}"
`;

