exports[`Schema Snapshots > Output Schemas > ExportLargeDatasetOutputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "additionalProperties": false,
          "description": "Standardized list envelope metadata",
          "properties": {
            "count": {
              "description": "Number of items in the current response page",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "hasMore": {
              "description": "True when more pages are available",
              "type": "boolean"
            },
            "itemsField": {
              "description": "Field name on response containing the current page item array",
              "minLength": 1,
              "type": "string"
            },
            "limit": {
              "description": "Page size used for this response",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "nextCursor": {
              "description": "Cursor/token for the next page",
              "type": "string"
            },
            "offset": {
              "description": "Offset used for this page when offset-based paging applies",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "totalCount": {
              "description": "Total matching item count when known",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "itemsField",
            "count"
          ],
          "type": "object"
        },
        "continuationHint": {
          "description": "Machine-readable hint describing how to continue retrieval",
          "type": "string"
        },
        "costEstimate": {
          "additionalProperties": false,
          "description": "API call cost estimate",
          "properties": {
            "apiCalls": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "cellsAffected": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "estimatedLatencyMs": {
              "minimum": 0,
              "type": "number"
            },
            "quotaImpact": {
              "additionalProperties": false,
              "properties": {
                "current": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "limit": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "remaining": {
