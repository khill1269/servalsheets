                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "cell",
                        "newValue"
                      ],
                      "type": "object"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "name": {
                    "description": "Scenario label",
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "changes"
                ],
                "type": "object"
              },
              "maxItems": 10,
              "minItems": 2,
              "type": "array"
            },
            "spreadsheetId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "action",
