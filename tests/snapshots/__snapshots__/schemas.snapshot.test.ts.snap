                "name": {
                  "description": "Scenario name (becomes sheet tab name)",
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "name",
                "changes"
              ],
              "type": "object"
            },
            "sourceSheetName": {
              "description": "Which sheet to duplicate as the scenario base. If omitted, inferred from the first cell reference in changes (e.g., \\"Sales!A1\\" → \\"Sales\\"). Falls back to first sheet.",
              "type": "string"
            },
            "spreadsheetId": {
              "minLength": 1,
              "type": "string"
            },
            "targetSheet": {
              "description": "Custom name for the new sheet tab",
              "type": "string"
            }
          },
          "required": [
            "action",
            "spreadsheetId",
            "scenario"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "request"
  ],
  "type": "object"
}"
