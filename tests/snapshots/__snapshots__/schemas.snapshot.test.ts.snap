exports[`Schema Snapshots > Input Schemas > SheetsWebhookInputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "request": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "register",
              "description": "Register a webhook to receive change notifications",
              "type": "string"
            },
            "eventTypes": {
              "description": "List of event types to subscribe to. Available: \\"sheet.update\\" (any change), \\"sheet.create\\" (new sheet), \\"sheet.delete\\" (sheet removed), \\"sheet.rename\\" (sheet renamed), \\"cell.update\\" (cell values changed), \\"format.update\\" (formatting changed), \\"all\\" (all events). Example: [\\"cell.update\\", \\"sheet.create\\"]",
              "items": {
                "description": "ServalSheets internal event filter category (applied server-side after receiving a Google Drive file-change notification). These are NOT Google API event type strings — Google only delivers file-level notifications. \\"sheet.update\\": Any structural or metadata change. \\"sheet.create\\"/\\"sheet.delete\\"/\\"sheet.rename\\": Tab lifecycle. \\"cell.update\\": Cell value changes. \\"format.update\\": Formatting changes. \\"all\\": All categories.",
                "enum": [
                  "sheet.update",
                  "sheet.create",
                  "sheet.delete",
                  "sheet.rename",
                  "cell.update",
                  "format.update",
                  "all"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "expirationMs": {
              "default": 43200000,
              "description": "How long the webhook channel stays active in milliseconds. Maximum: 86400000 (1 day, enforced by Google Drive files.watch API). Default: 43200000 (12 hours — provides a safe buffer before the 1-day limit). You must re-register after expiration. Example: 86400000 for maximum lifetime.",
              "exclusiveMinimum": 0,
              "maximum": 86400000,
              "type": "integer"
            },
            "secret": {
              "description": "Shared secret for HMAC-SHA256 signature verification of incoming webhook payloads. When set, each delivery includes an X-Serval-Signature header computed as HMAC-SHA256(secret, payload). Your endpoint should verify this to prevent spoofing. Auto-generated (and returned once) if not provided. Min 16 characters. Example: \\"my-webhook-secret-key-min-16-chars\\"",
              "minLength": 16,
              "type": "string"
            },
            "spreadsheetId": {
              "description": "Spreadsheet ID from the Google Sheets URL — the long alphanumeric string between /d/ and /edit. Example: \\"1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms\\"",
              "minLength": 1,
              "type": "string"
            },
            "webhookUrl": {
              "description": "HTTPS endpoint that receives webhook POST payloads when events fire. Must be HTTPS (HTTP is rejected for security). Must be publicly reachable by Google. Example: \\"https://your-server.example.com/webhooks/sheets\\"",
              "format": "uri",
              "pattern": "^https:\\\\/\\\\/.*",
              "type": "string"
            }
          },
          "required": [
            "action",
            "spreadsheetId",
            "webhookUrl",
            "eventTypes",
            "expirationMs"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "unregister",
              "description": "Unregister an existing webhook",
              "type": "string"
            },
            "webhookId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "action",
            "webhookId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "list",
              "description": "List all registered webhooks",
              "type": "string"
            },
            "active": {
              "description": "Filter by active status",
              "type": "boolean"
            },
            "spreadsheetId": {
              "description": "Filter by spreadsheet ID",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "get",
              "description": "Get details of a specific webhook",
              "type": "string"
            },
            "webhookId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "action",
            "webhookId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "test",
              "description": "Send a test payload to a webhook endpoint",
              "type": "string"
            },
            "webhookId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "action",
            "webhookId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "get_stats",
              "description": "Get delivery statistics for webhooks",
              "type": "string"
            },
            "webhookId": {
              "description": "Get stats for specific webhook",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "watch_changes",
              "description": "Set up Google Drive push notifications for a spreadsheet using files.watch API — notifies your endpoint when the file changes",
              "type": "string"
            },
            "channelId": {
              "description": "Custom channel ID (auto-generated if not provided)",
              "minLength": 1,
              "type": "string"
            },
            "expirationMs": {
              "default": 43200000,
              "description": "Channel expiration in milliseconds (max 1 day per Drive API limit)",
              "exclusiveMinimum": 0,
              "maximum": 86400000,
              "type": "integer"
            },
            "spreadsheetId": {
              "minLength": 1,
              "type": "string"
            },
            "webhookUrl": {
              "format": "uri",
              "pattern": "^https:\\\\/\\\\/.*",
              "type": "string"
            }
          },
          "required": [
            "action",
            "spreadsheetId",
            "webhookUrl",
            "expirationMs"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "subscribe_workspace",
              "description": "Create a Google Workspace Events subscription for a spreadsheet via Cloud Pub/Sub. IMPORTANT: The Workspace Events API for Google Drive/Sheets is currently in DEVELOPER PREVIEW (launched July 2025). Delivers file-level change notifications only (google.workspace.drive.file.v3.contentChanged) — no sheet-tab or cell-level granularity from Google. ServalSheets polls the Sheets API after each notification to determine what changed. Requires a Cloud Pub/Sub topic (not a direct HTTP endpoint).",
              "type": "string"
            },
            "notificationEndpoint": {
              "description": "Cloud Pub/Sub topic to receive Workspace Events notifications (format: projects/{project}/topics/{topic}). The Workspace Events API delivers to Pub/Sub only — not to HTTP endpoints directly.",
              "pattern": "^projects\\\\/[^/]+\\\\/topics\\\\/[^/]+$",
              "type": "string"
            },
            "spreadsheetId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "action",
            "spreadsheetId",
            "notificationEndpoint"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "reactivate_workspace",
              "description": "Reactivate a suspended Google Workspace Events subscription after resolving the suspension cause.",
              "type": "string"
            },
            "subscriptionId": {
              "description": "Subscription ID returned by subscribe_workspace or list_workspace_subscriptions",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "action",
            "subscriptionId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "unsubscribe_workspace",
              "type": "string"
            },
            "subscriptionId": {
              "description": "Subscription ID returned by subscribe_workspace",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "action",
            "subscriptionId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "list_workspace_subscriptions",
              "type": "string"
            },
            "spreadsheetId": {
              "description": "Filter by spreadsheet ID (omit for all subscriptions)",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "request"
  ],
  "type": "object"
}"
`;

exports[`Schema Snapshots > Input Schemas > SmartAppendInputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "smart_append",
      "description": "Append data matching column headers",
      "type": "string"
    },
    "createMissingColumns": {
      "default": false,
      "description": "Create columns for unmatched headers (default: false | set true to auto-create columns)",
      "type": "boolean"
    },
    "data": {
      "description": "MUST be array of objects keyed by header names, e.g. [{\\"Name\\": \\"Alice\\", \\"Age\\": 30}]. Do NOT use arrays of arrays [[val1, val2]] — that format will fail. Values can be string, number, boolean, null, array, or object.",
      "items": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "additionalProperties": {},
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            }
          ]
        },
        "propertyNames": {
          "type": "string"
        },
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "matchHeaders": {
      "default": true,
      "description": "Match columns by header name (default: true | set false for positional matching)",
      "type": "boolean"
    },
    "safety": {
      "additionalProperties": false,
      "description": "Safety options: dryRun for preview, autoSnapshot for automatic backups",
      "properties": {
        "autoSnapshot": {
          "default": true,
          "type": "boolean"
        },
        "confirmed": {
          "description": "Pre-approval bypass for destructive operations when the MCP client does not support interactive elicitation. Pass true after reviewing the operation details out-of-band. Equivalent to answering \\"Yes, proceed\\" to the elicitation prompt. Has no effect on non-destructive operations.",
          "type": "boolean"
        },
        "dryRun": {
          "default": false,
          "type": "boolean"
        },
        "effectScope": {
          "additionalProperties": false,
          "properties": {
            "maxCellsAffected": {
              "default": 50000,
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "maxColumnsAffected": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "maxRowsAffected": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "requireExplicitRange": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "maxCellsAffected",
            "requireExplicitRange"
          ],
          "type": "object"
        },
        "expectedState": {
          "additionalProperties": false,
          "properties": {
            "checksum": {
              "description": "MD5 hash of range values to verify",
              "type": "string"
            },
            "checksumRange": {
              "description": "A1 range for checksum calculation (default: A1:J10)",
              "type": "string"
            },
            "columnCount": {
              "description": "Expected total column count",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "firstRowValues": {
              "description": "Expected header values in first row",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "rowCount": {
              "description": "Expected total row count",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "sheetTitle": {
              "description": "Sheet title that must exist",
              "type": "string"
            },
            "version": {
              "description": "Specific version to validate",
              "type": "string"
            }
          },
          "type": "object"
        },
        "sanitizeFormulas": {
          "default": true,
          "description": "When true, reject cell values containing dangerous data-exfiltration formulas (IMPORTDATA, IMPORTRANGE, IMPORTFEED, IMPORTHTML, IMPORTXML, GOOGLEFINANCE, QUERY). Returns FORMULA_INJECTION_BLOCKED error if detected.",
          "type": "boolean"
        },
        "transactionId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        }
      },
      "required": [
        "dryRun",
        "autoSnapshot",
        "sanitizeFormulas"
      ],
      "type": "object"
    },
    "sheet": {
      "anyOf": [
        {
          "description": "Sheet name",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\\\\\\\/?*[\\\\]]+$",
          "type": "string"
        },
        {
          "description": "Sheet ID",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      ],
      "description": "Target sheet - name or ID"
    },
    "skipEmptyRows": {
      "default": true,
      "description": "Skip rows with all empty values (default: true | set false to include empty rows)",
      "type": "boolean"
    },
    "spreadsheetId": {
      "description": "Spreadsheet ID from URL",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9-_]+$",
      "type": "string"
    },
    "verbosity": {
      "default": "standard",
      "description": "Response detail level: minimal (essential info only, measured 25-88% fewer tokens per response, mean ~62% across 5 shapes — see tests/benchmarks/verbosity-token-reduction.test.ts), standard (balanced), detailed (full metadata)",
      "enum": [
        "minimal",
        "standard",
        "detailed"
      ],
      "type": "string"
    }
  },
  "required": [
    "action",
    "spreadsheetId",
    "sheet",
    "data",
    "matchHeaders",
    "createMissingColumns",
    "skipEmptyRows",
    "verbosity"
  ],
  "type": "object"
}"
`;

