                  "type": "boolean"
                },
                "transactionId": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string"
                }
              },
              "required": [
                "dryRun",
                "autoSnapshot",
                "sanitizeFormulas"
              ],
              "type": "object"
            },
            "spreadsheetId": {
              "description": "Spreadsheet ID from URL",
              "minLength": 1,
              "type": "string"
            },
            "verbosity": {
              "default": "standard",
              "description": "Response detail level: minimal (essential info only, ~25-88% fewer tokens; measured mean 62%), standard (balanced), detailed (full metadata)",
              "enum": [
                "minimal",
                "standard",
                "detailed"
              ],
              "type": "string"
            }
          },
          "required": [
            "verbosity",
            "action",
            "spreadsheetId",
            "operation"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "request"
  ],
  "type": "object"
}"
