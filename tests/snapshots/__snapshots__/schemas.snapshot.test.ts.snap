            "timestamp"
          ],
          "type": "object"
        },
        "suggestions": {
          "description": "Follow-up tool suggestions and optimizations",
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "priority": {
                "default": "medium",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "optimization",
                  "alternative",
                  "follow_up",
                  "warning",
                  "related"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "message",
              "reason",
              "priority"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "summary": {
          "additionalProperties": false,
          "description": "Summary statistics for list-type responses",
          "properties": {
            "byStatus": {
              "additionalProperties": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              "description": "Counts grouped by status",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "total": {
              "description": "Total item count",
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "total"
          ],
          "type": "object"
        },
        "truncated": {
          "description": "True when response payload was truncated and full data is available elsewhere",
          "type": "boolean"
        },
        "verificationSummary": {
          "description": "Short verification summary describing what was checked or confirmed",
          "type": "string"
        },
        "warnings": {
          "description": "Safety warnings or considerations",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "action": {
      "const": "batch_operations",
      "type": "string"
    },
    "failed": {
      "description": "Number of failed operations",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "results": {
      "description": "Results for each operation",
      "items": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "description": "Action that was called",
            "type": "string"
          },
          "data": {
            "description": "Operation result (if successful)"
          },
          "error": {
            "additionalProperties": false,
            "description": "Error details (if failed)",
            "properties": {
              "code": {
                "type": "string"
              },
              "details": {
                "additionalProperties": {},
                "propertyNames": {
                  "type": "string"
                },
                "type": "object"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "index": {
            "description": "Operation index in request",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "success": {
            "description": "Whether this operation succeeded",
            "type": "boolean"
          },
          "tool": {
            "description": "Tool that was called",
            "type": "string"
          }
        },
        "required": [
          "index",
          "tool",
          "action",
          "success"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "succeeded": {
      "description": "Number of successful operations",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "success": {
      "const": true,
      "type": "boolean"
    },
    "total": {
      "description": "Total operations requested",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "success",
    "action",
    "total",
    "succeeded",
    "failed",
    "results"
  ],
  "type": "object"
}"
`;

