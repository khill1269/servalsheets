exports[`Schema Snapshots > Input Schemas > CompositeInputSchema should match snapshot 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "request": {
      "oneOf": [
