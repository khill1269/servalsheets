            }
          },
          "type": "object"
        },
        "sanitizeFormulas": {
          "default": true,
          "description": "When true, reject cell values containing dangerous data-exfiltration formulas (IMPORTDATA, IMPORTRANGE, IMPORTFEED, IMPORTHTML, IMPORTXML, GOOGLEFINANCE, QUERY). Returns FORMULA_INJECTION_BLOCKED error if detected.",
          "type": "boolean"
        },
        "transactionId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        }
      },
      "required": [
        "dryRun",
        "autoSnapshot",
        "sanitizeFormulas"
      ],
      "type": "object"
    },
    "sheet": {
      "anyOf": [
        {
          "description": "Sheet name",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\\\\\\\/?*[\\\\]]+$",
          "type": "string"
        },
        {
          "description": "Sheet ID",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      ],
      "description": "Target sheet (creates new if not specified)"
    },
    "skipEmptyRows": {
      "default": true,
      "description": "Skip empty rows (default: true | set false to include empty rows)",
      "type": "boolean"
    },
    "spreadsheetId": {
      "description": "Spreadsheet ID from URL",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9-_]+$",
      "type": "string"
    },
    "trimValues": {
      "default": true,
      "description": "Trim whitespace from values (default: true | set false to preserve whitespace)",
      "type": "boolean"
    },
    "verbosity": {
      "default": "standard",
      "description": "Response detail level: minimal (essential info only, measured 25-88% fewer tokens per response, mean ~62% across 5 shapes — see tests/benchmarks/verbosity-token-reduction.test.ts), standard (balanced), detailed (full metadata)",
      "enum": [
        "minimal",
        "standard",
        "detailed"
      ],
      "type": "string"
    }
  },
  "required": [
    "action",
    "spreadsheetId",
    "csvData",
    "delimiter",
    "hasHeader",
    "mode",
    "skipEmptyRows",
    "trimValues",
    "verbosity"
  ],
  "type": "object"
}"
`;

