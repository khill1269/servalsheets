          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "formattingCopied": {
          "type": "boolean"
        },
        "headerRowsPreserved": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "newSheetId": {
          "description": "Numeric sheet/tab ID (e.g., 0 for first sheet, found in URL #gid=123456789). Use sheets_core get to retrieve sheet IDs.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "newSheetName": {
          "description": "Sheet/tab name (no special chars: \\\\ / ? * [ ])",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\\\\\\\/?*[\\\\]]+$",
          "type": "string"
        },
        "success": {
          "const": true,
          "type": "boolean"
        },
        "validationCopied": {
          "type": "boolean"
        }
      },
      "required": [
        "success",
        "action",
        "newSheetId",
