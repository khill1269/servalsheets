                    "BATCH_UPDATE_ERROR",
                    "TRANSACTION_ERROR",
                    "ABORTED",
                    "DEADLINE_EXCEEDED",
                    "CANCELLED",
                    "OPERATION_CANCELLED",
                    "OPERATION_FAILED",
