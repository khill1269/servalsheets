                  "propertyNames": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "snapshotId": {
                  "description": "Unique snapshot identifier",
                  "type": "string"
                },
                "timestamp": {
                  "description": "ISO 8601 timestamp of snapshot creation",
                  "type": "string"
                }
              },
              "required": [
                "snapshotId",
                "timestamp"
              ],
              "type": "object"
            },
            "suggestions": {
              "description": "Follow-up tool suggestions and optimizations",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "priority": {
                    "default": "medium",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ],
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "tool": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "optimization",
                      "alternative",
                      "follow_up",
                      "warning",
                      "related"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "message",
                  "reason",
                  "priority"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "summary": {
              "additionalProperties": false,
              "description": "Summary statistics for list-type responses",
              "properties": {
                "byStatus": {
                  "additionalProperties": {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  "description": "Counts grouped by status",
                  "propertyNames": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "total": {
                  "description": "Total item count",
                  "maximum": 9007199254740991,
                  "minimum": -9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "total"
              ],
              "type": "object"
            },
            "truncated": {
              "description": "True when response payload was truncated and full data is available elsewhere",
              "type": "boolean"
            },
            "verificationSummary": {
              "description": "Short verification summary describing what was checked or confirmed",
              "type": "string"
            },
            "warnings": {
              "description": "Safety warnings or considerations",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "action": {
          "const": "build_dashboard",
          "type": "string"
        },
        "chartsAdded": {
          "description": "Number of charts embedded",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "dashboardSheet": {
          "description": "Name of the created dashboard sheet",
          "type": "string"
        },
        "kpisAdded": {
          "description": "Number of KPI metrics added",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "description": "Summary of the dashboard creation",
          "type": "string"
        },
        "slicersAdded": {
          "description": "Number of slicers added",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "success": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "success",
        "action",
        "dashboardSheet",
        "kpisAdded",
        "chartsAdded",
        "slicersAdded",
        "message"
      ],
      "type": "object"
    }
  ]
}"
`;

