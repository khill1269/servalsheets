          "description": "Safety warnings or considerations",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "action": {
      "const": "setup_sheet",
      "type": "string"
    },
    "apiCallsSaved": {
      "description": "Number of API calls saved vs manual setup",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "columnCount": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "rowsCreated": {
      "description": "Number of data rows created (beyond header)",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "sheetId": {
      "description": "Numeric sheet/tab ID (e.g., 0 for first sheet, found in URL #gid=123456789). Use sheets_core get to retrieve sheet IDs.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "sheetName": {
      "description": "Sheet/tab name (no special chars: \\\\ / ? * [ ])",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\\\\\\\/?*[\\\\]]+$",
      "type": "string"
    },
    "success": {
      "const": true,
      "type": "boolean"
    }
  },
  "required": [
    "success",
    "action",
    "sheetId",
    "sheetName",
    "columnCount",
    "rowsCreated",
    "apiCallsSaved"
  ],
  "type": "object"
}"
`;

