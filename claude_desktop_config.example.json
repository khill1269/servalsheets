{
  "_instructions": [
    "PRODUCTION (Claude Desktop): Copy this file to ~/Library/Application Support/Claude/claude_desktop_config.json",
    "MCP INSPECTOR: npx @modelcontextprotocol/inspector -- node dist/cli.js",
    "  Then open: http://localhost:6274  (browser UI) / http://localhost:6277 (proxy)",
    "DEV MODE: Replace 'node dist/cli.js' with 'npx tsx src/server.ts' for hot reload"
  ],
  "mcpServers": {
    "servalsheets": {
      "command": "node",
      "args": ["/absolute/path/to/servalsheets 2/dist/cli.js"],
      "env": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "OAUTH_CLIENT_ID": "your-client-id.apps.googleusercontent.com",
        "OAUTH_CLIENT_SECRET": "your-client-secret",
        "OAUTH_REDIRECT_URI": "http://localhost:3000/callback",
        "GOOGLE_TOKEN_STORE_PATH": "/Users/your-user/.config/servalsheets/tokens.enc",
        "ENCRYPTION_KEY": "<64-char-hex-key>"
      }
    },
    "servalsheets-dev": {
      "_comment": "Hot-reload dev mode — no build step needed",
      "command": "npx",
      "args": ["tsx", "/absolute/path/to/servalsheets 2/src/server.ts"],
      "env": {
        "NODE_ENV": "development",
        "LOG_LEVEL": "debug",
        "SESSION_STORE_TYPE": "memory",
        "ALLOW_MEMORY_SESSIONS": "true",
        "CACHE_REDIS_ENABLED": "false",
        "OAUTH_CLIENT_ID": "your-client-id.apps.googleusercontent.com",
        "OAUTH_CLIENT_SECRET": "your-client-secret",
        "OAUTH_REDIRECT_URI": "http://localhost:3000/callback",
        "GOOGLE_TOKEN_STORE_PATH": "/Users/your-user/.config/servalsheets/tokens.enc",
        "ENCRYPTION_KEY": "<64-char-hex-key>"
      }
    }
  }
}
